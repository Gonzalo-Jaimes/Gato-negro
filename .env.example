# Copia este archivo como .env y completa los valores reales.
# Nunca subas el .env real al repositorio.

# Clave para firmar la cookie de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=

# Proyecto de Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Bot de Telegram (opcional: sin esto, el bot queda desactivado)
TELEGRAM_TOKEN=

# Google Gemini, para los módulos de análisis con IA (opcional)
GEMINI_API_KEY=

# Puerto local (opcional, por defecto 3000)
PORT=3000

# IDs de Telegram autorizados, separados por coma (si no se define, usa la lista por defecto del código)
ADMIN_IDS=

# Modelos de Gemini para transcribir voz (opcional)
GEMINI_AUDIO_MODEL=
GEMINI_AUDIO_FALLBACK=
