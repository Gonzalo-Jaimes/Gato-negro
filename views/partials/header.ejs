<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gato Negro | RPM v3.2.6</title>
    
    <script>
        /* Aplicar dark mode ANTES de pintar para evitar el flash blanco */
        if (localStorage.getItem('gato-dark-mode') === 'true') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
    
    <!-- Sistema de Diseño v3.0 -->
    <link rel="stylesheet" href="/css/theme.css">
    <%- include('cat-head', { accept: ['login>panel'] }) %>

    <style>
        /* --- ESTILOS DE LAYOUT V3.0 --- */
        :root {
            --sidebar-width: 260px;
            --topbar-height: 64px;
        }

        body { 
            background: var(--bg-main); 
            color: var(--text-main);
            min-height: 100vh;
        }

        /* HEADER GLASSMORPHIC */
        .topbar { 
            height: var(--topbar-height);
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: var(--z-sticky);
        }
        .topbar-brand {
            font-family: var(--font-head);
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-main);
        }

        .container { display: flex; min-height: calc(100vh - var(--topbar-height)); }

        /* SIDEBAR MODERNO */
        .sidebar { 
            width: var(--sidebar-width); 
            background: var(--bg-card);
            border-right: 1px solid var(--border-color);
            padding: 24px 16px;
            flex-shrink: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            position: sticky;
            top: var(--topbar-height);
            height: calc(100vh - var(--topbar-height));
        }

        .sidebar.collapsed { 
            width: 0; 
            padding: 24px 0;
            opacity: 0;
            pointer-events: none;
        }

        .sidebar-section { margin-bottom: 24px; }
        .sidebar-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 12px;
            padding-left: 12px;
            font-weight: 600;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-main);
            text-decoration: none;
            padding: 10px 12px;
            border-radius: 10px;
            font-weight: 500;
            transition: all 0.2s;
            margin-bottom: 4px;
        }
        .nav-item:hover {
            background: var(--primary-soft);
            color: var(--primary);
        }
        .nav-item.active {
            background: var(--primary);
            color: var(--on-primary);
            box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);
        }
        .submenu a.active {
            color: var(--primary);
            background: var(--primary-soft);
            font-weight: 600;
            box-shadow: inset 2px 0 0 var(--primary);
        }

        .submenu {
            margin-left: 12px;
            border-left: 1px solid var(--border-color);
            margin-bottom: 12px;
            display: none;
        }
        .submenu a {
            display: block;
            padding: 8px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            border-radius: 0 8px 8px 0;
            transition: all 0.2s;
        }
        .submenu a:hover { color: var(--primary); background: var(--primary-soft); }

        /* NAVEGACIÓN: grupos desplegables accesibles */
        .nav-icon { display: inline-block; width: 1.4em; text-align: center; }
        .nav-toggle { width: 100%; background: none; border: 0; font: inherit; cursor: pointer; text-align: left; }
        .nav-toggle::after {
            content: ''; margin-left: auto; width: 7px; height: 7px;
            border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
            transform: rotate(-45deg); transition: transform 0.15s ease-out;
        }
        .nav-toggle[aria-expanded="true"]::after { transform: rotate(45deg); }
        .nav-toggle.has-active { color: var(--primary); font-weight: 600; }
        .sidebar a:focus-visible, .nav-toggle:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
        @media (prefers-reduced-motion: reduce) { .nav-toggle::after { transition: none; } }

        /* CONTENT AREA */
        .content { 
            flex: 1; 
            padding: 32px; 
            min-width: 0; 
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Tarjeta, campos, etiqueta y tabla globales: ver public/css/theme.css (sistema de diseño) */

        /* BOTONES TOPBAR */
        .btn-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            color: var(--text-main);
            transition: all 0.2s;
        }
        .btn-icon:hover { background: var(--primary-soft); }
        .btn-icon:active { transform: scale(0.95); }

        /* RESPONSIVIDAD OVERLAY V3 */
        @media (max-width: 1024px) {
            .sidebar {
                position: fixed;
                left: -100%;
                z-index: var(--z-sidebar-mobile);
                box-shadow: 20px 0 50px rgba(0,0,0,0.2);
            }
            .sidebar.mobile-open { left: 0; }
            .content { padding: 20px; }
        }
    </style>

    <script>
        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark-mode');
            localStorage.setItem('gato-dark-mode', document.documentElement.classList.contains('dark-mode'));
        }
        function toggleNav() {
            const sb = document.getElementById('main-sidebar');
            if (window.innerWidth <= 1024) {
                sb.classList.toggle('mobile-open');
            } else {
                sb.classList.toggle('collapsed');
            }
        }
        function toggleSub(btn) {
            const el = document.getElementById(btn.getAttribute('aria-controls'));
            const abierto = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!abierto));
            el.style.display = abierto ? 'none' : 'block';
        }

        /* NAVEGACIÓN: botones de grupo + marcado de la página actual por URL */
        window.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.nav-toggle').forEach(b => b.addEventListener('click', () => toggleSub(b)));

            const path = window.location.pathname;
            document.querySelectorAll('.sidebar nav a[href]').forEach(link => {
                const extras = (link.dataset.tambien || '').split(',').filter(Boolean);
                const coincide = link.getAttribute('href') === path ||
                    extras.some(p => path === p || path.startsWith(p + '/'));
                if (!coincide) return;

                link.classList.add('active');
                link.setAttribute('aria-current', 'page');

                const sub = link.closest('.submenu');
                if (sub) {
                    sub.style.display = 'block';
                    const btn = document.querySelector('[aria-controls="' + sub.id + '"]');
                    if (btn) { btn.setAttribute('aria-expanded', 'true'); btn.classList.add('has-active'); }
                }
            });
        });
    </script>
    <script src="/js/ui.js" defer></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <%- include('cat-loader', { idle: true }) %>

<header class="topbar">
    <div class="topbar-brand">
        <img src="/img/logo.png" alt="Logo" style="height: 32px; width: auto;">
        <span>Gato Negro <small style="font-weight: 400; opacity: 0.6; font-size: 0.8rem;">RPM v3.2.6</small></span>
    </div>

    <div style="display: flex; gap: 8px;">
        <button class="btn-icon" onclick="toggleDarkMode()" title="Cambiar Tema">🌓</button>
        <button class="btn-icon" onclick="toggleNav()" title="Menú">☰</button>
    </div>
</header>

<div class="container">

<aside class="sidebar" id="main-sidebar">
<%
    /* Fuente única del mapa de navegación (ver documentacion/taller/04_arquitectura_informacion.md).
       hijos => grupo desplegable; tambien => rutas hijas que mantienen activo el ítem. */
    let menu;
    if (session.rol === 'admin') {
        menu = [
            { etiqueta: 'Resumen', items: [
                { icono: '📈', texto: 'Analítica', href: '/analitica' },
                { icono: '📦', texto: 'Inventario', href: '/inventario' }
            ]},
            { etiqueta: 'Producción', items: [
                { id: 'bodega', icono: '🏬', texto: 'Bodega', hijos: [
                    { texto: 'Despachar material', href: '/bodega' },
                    { texto: 'Mermas y compras', href: '/mermas' }
                ]},
                { id: 'fabriquines', icono: '🏭', texto: 'Fabriquines', hijos: [
                    { texto: 'Asignar tarea', href: '/despacho', tambien: ['/imprimir_despacho', '/historial_prestamo'] },
                    { texto: 'Recibir producción', href: '/recepcion_diaria' },
                    { texto: 'Recibir tareas y rezagos', href: '/recepcion_general' }
                ]},
                { id: 'envolvedoras', icono: '🌯', texto: 'Envolvedoras', hijos: [
                    { texto: 'Asignar semana', href: '/envolvedoras/despacho' },
                    { texto: 'Recibir producción', href: '/envolvedoras/control' }
                ]},
                { id: 'anilladores', icono: '💍', texto: 'Anilladores', hijos: [
                    { texto: 'Asignar trabajo', href: '/anilladores/despacho' },
                    { texto: 'Recibir producción', href: '/anilladores/recepcion' },
                    { texto: 'Inventario y personal', href: '/anilladores/inventario' }
                ]},
                { id: 'empaque', icono: '🎁', texto: 'Empaque', hijos: [
                    { texto: 'Asignar trabajo', href: '/despachos_empaque', tambien: ['/despacho_empaque'] },
                    { texto: 'Recibir producción', href: '/empacadores/recepcion' }
                ]},
                { icono: '📋', texto: 'Pedidos', href: '/pedidos' },
                { icono: '🔎', texto: 'Historial de entregas', href: '/entregas_historicas' }
            ]},
            { etiqueta: 'Finanzas y control', items: [
                { icono: '🔄', texto: 'Kardex', href: '/movimientos' },
                { icono: '💰', texto: 'Nómina', href: '/nomina', tambien: ['/imprimir_nomina_v18'] },
                { icono: '🖨️', texto: 'Facturas', href: '/facturas', tambien: ['/factura_detalle', '/factura_nomina', '/reimprimir_factura'] }
            ]},
            { etiqueta: 'Mantenimiento', items: [
                { icono: '⚙️', texto: 'Equipos', href: '/maquinas', tambien: ['/lista', '/ficha', '/maquinas/ficha', '/ficha_maquina'] },
                { icono: '🔧', texto: 'Órdenes', href: '/mantenimiento' },
                { icono: '🏷️', texto: 'Etiquetas QR', href: '/maquinas/qrs' }
            ]},
            { etiqueta: 'Administración', items: [
                { icono: '👥', texto: 'Empleados', href: '/empleados' },
                { icono: '👤', texto: 'Accesos', href: '/usuarios' },
                { icono: '🎨', texto: 'Guía de estilos', href: '/guia_estilos' }
            ]}
        ];
    } else if (session.rol === 'mantenimiento') {
        menu = [
            { etiqueta: 'Área técnica', items: [
                { icono: '⚙️', texto: 'Ver máquinas', href: '/maquinas', tambien: ['/lista', '/ficha', '/maquinas/ficha', '/ficha_maquina'] },
                { icono: '🔧', texto: 'Subir mantenimiento', href: '/mantenimiento' }
            ]}
        ];
    } else {
        menu = [
            { items: [
                { icono: '📋', texto: 'Pedidos', href: '/pedidos' },
                { icono: '💵', texto: 'Mi producción', href: '/cierre_diario' }
            ]}
        ];
    }
%>
    <nav aria-label="Navegación principal">
    <% menu.forEach(function (seccion) { %>
        <div class="sidebar-section">
            <% if (seccion.etiqueta) { %><div class="sidebar-label"><%= seccion.etiqueta %></div><% } %>
            <% seccion.items.forEach(function (it) { %>
                <% if (it.hijos) { %>
                    <button type="button" class="nav-item nav-toggle" aria-expanded="false" aria-controls="submenu-<%= it.id %>">
                        <span class="nav-icon" aria-hidden="true"><%= it.icono %></span><span><%= it.texto %></span>
                    </button>
                    <div id="submenu-<%= it.id %>" class="submenu">
                        <% it.hijos.forEach(function (h) { %>
                            <a href="<%= h.href %>"<% if (h.tambien) { %> data-tambien="<%= h.tambien.join(',') %>"<% } %>><%= h.texto %></a>
                        <% }); %>
                    </div>
                <% } else { %>
                    <a href="<%= it.href %>" class="nav-item"<% if (it.tambien) { %> data-tambien="<%= it.tambien.join(',') %>"<% } %>>
                        <span class="nav-icon" aria-hidden="true"><%= it.icono %></span><span><%= it.texto %></span>
                    </a>
                <% } %>
            <% }); %>
        </div>
    <% }); %>
    </nav>

    <div style="margin-top: 40px; padding: 0 12px;">
        <a href="/logout" class="btn" style="display: block; text-align: center; text-decoration: none; padding: 12px; font-size: 0.9rem; background: transparent; color: var(--danger); border: 1px solid var(--danger);">SALIR DEL SISTEMA</a>
    </div>
</aside>

<main class="content" id="contenido" tabindex="-1">
