<%- include('../partials/header') %>

<!-- SELECT2 & JQUERY CDNs -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<style>
    /* Soporte Dark Mode Robusto para la Librería Select2 */
    html.dark-mode .select2-container--default .select2-selection--single { background-color: #222 !important; border-color: #444 !important; color: white !important; height: 38px; }
    html.dark-mode .select2-container--default .select2-selection--single .select2-selection__rendered { color: white !important; line-height: 38px; }
    html.dark-mode .select2-dropdown { background-color: #222 !important; color: white !important; border-color: #444 !important; z-index: 9999; }
    html.dark-mode .select2-container--default .select2-results__option--selected { background-color: #444 !important; }
    html.dark-mode .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable { background-color: #3b82f6 !important; color: white !important; }
    html.dark-mode .select2-search--dropdown .select2-search__field { background-color: #111 !important; color: white !important; border: 1px solid #555 !important; }

    /* === DARK MODE: MODALES DE MANTENIMIENTO === */
    html.dark-mode #modal-detalle-mtto > div,
    html.dark-mode #modal-completar-mtto > div,
    html.dark-mode #modal-responder-solicitud > div {
        background: #111111 !important;
        color: #e5e7eb !important;
        border: 1px solid #333 !important;
    }
    html.dark-mode #modal-detalle-mtto [style*="background:#f8fafc"],
    html.dark-mode #modal-detalle-mtto [style*="background: #f8fafc"] {
        background: #1a1a1a !important;
        border: 1px solid #2d2d2d !important;
    }
    html.dark-mode #modal-detalle-mtto [style*="background:#eff6ff"],
    html.dark-mode #modal-detalle-mtto [style*="background: #eff6ff"] {
        background: #0f1f3d !important;
        border-left-color: #3b82f6 !important;
    }
    html.dark-mode #modal-detalle-mtto [style*="color:#1d4ed8"] { color: #60a5fa !important; }
    html.dark-mode #modal-detalle-mtto [style*="color:#1e3a5f"] { color: #93c5fd !important; }
    html.dark-mode #modal-detalle-mtto [style*="background:#f0fdf4"] { background: #0a2010 !important; }
    html.dark-mode #modal-detalle-mtto [style*="color:#15803d"],
    html.dark-mode #modal-detalle-mtto [style*="color:#166534"] { color: #4ade80 !important; }
    html.dark-mode #modal-detalle-mtto [style*="background:#fefce8"] { background: #1e1600 !important; }
    html.dark-mode #modal-detalle-mtto [style*="color:#92400e"],
    html.dark-mode #modal-detalle-mtto [style*="color:#78350f"] { color: #fcd34d !important; }
    html.dark-mode #modal-detalle-mtto [style*="background:#fef2f2"] { background: #1e0808 !important; }
    html.dark-mode #modal-detalle-mtto [style*="color:#991b1b"],
    html.dark-mode #modal-detalle-mtto [style*="color:#7f1d1d"] { color: #fca5a5 !important; }
    html.dark-mode #modal-detalle-mtto button[style*="color:#666"] { color: #aaa !important; }
    html.dark-mode #modal-detalle-mtto [style*="border-top:1px solid #e5e7eb"],
    html.dark-mode #modal-detalle-mtto [style*="border-top: 1px solid #e5e7eb"] { border-color: #333 !important; }
    html.dark-mode #modal-detalle-mtto [style*="color:#111"] { color: #f3f4f6 !important; }

    .badge-estado {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }
    .badge-realizado { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .badge-pendiente { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .badge-solicitado { background: rgba(249, 115, 22, 0.18); color: #ea580c; }
    .badge-aprobado { background: rgba(59, 130, 246, 0.18); color: #3b82f6; }
    .badge-rechazado { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
</style>

<%
    const esAdmin = session && session.rol === 'admin';
    const usuarioActual = (session && session.usuario) ? session.usuario : 'manolo';
    const solicitudesActivas = (mantenimientos || []).filter(m => m.estado === 'SOLICITADO' || m.estado === 'APROBADO');
    const tareasPendientes = (mantenimientos || []).filter(m => m.estado === 'NO REALIZADO');
%>

<h1>🔧 Área de Mantenimiento y Órdenes de Trabajo</h1>
<hr>

<!-- ========================================================================= -->
<!-- 1. BANDEJA DE SOLICITUDES DE CORRECTIVO (SOLICITADO / APROBADO)           -->
<!-- ========================================================================= -->
<% if (solicitudesActivas.length > 0) { %>
<div class="card" style="border-left: 5px solid #ea580c; margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
        <h2 style="margin: 0; font-size: 1.2rem;">🚨 Solicitudes de Mantenimiento Correctivo (<%= solicitudesActivas.length %>)</h2>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
            <%= esAdmin ? 'Revisa y aprueba o rechaza las solicitudes enviadas por el mecánico' : 'Estado de tus solicitudes de correctivo' %>
        </span>
    </div>

    <table>
        <tr>
            <th>Nº Mtto (Máq.)</th>
            <th>Fecha</th>
            <th>Máquina</th>
            <th>Solicitado por</th>
            <th>Falla / Descripción</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
        <% solicitudesActivas.forEach(function(sol) { %>
        <tr>
            <td><strong># <%= sol.nro_maquina || 1 %></strong></td>
            <td><%= sol.fecha %><br><small><%= sol.hora %></small></td>
            <td><strong><%= sol.maquina %></strong></td>
            <td><%= sol.hecho_por %></td>
            <td style="max-width: 340px;"><%= sol.descripcion %></td>
            <td>
                <% if (sol.estado === 'SOLICITADO') { %>
                    <span class="badge-estado badge-solicitado">⏳ Pendiente de Aprobación</span>
                <% } else if (sol.estado === 'APROBADO') { %>
                    <span class="badge-estado badge-aprobado">✅ Aprobado — Listo para Ejecutar</span>
                <% } %>
            </td>
            <td>
                <% if (sol.estado === 'SOLICITADO' && esAdmin) { %>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button type="button" onclick="abrirModalRespuesta(<%= sol.id %>, <%= sol.nro_maquina || 1 %>, '<%= sol.maquina.replace(/'/g, "\\'") %>', 'APROBADO')" style="background: #10b981; color: black; font-weight: bold; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer;">
                            ✅ Aprobar
                        </button>
                        <button type="button" onclick="abrirModalRespuesta(<%= sol.id %>, <%= sol.nro_maquina || 1 %>, '<%= sol.maquina.replace(/'/g, "\\'") %>', 'RECHAZADO')" style="background: #ef4444; color: white; font-weight: bold; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer;">
                            ❌ Rechazar
                        </button>
                    </div>
                <% } else if (sol.estado === 'SOLICITADO' && !esAdmin) { %>
                    <small style="color: var(--text-muted);">Esperando autorización del Admin</small>
                <% } else if (sol.estado === 'APROBADO') { %>
                    <button type="button" onclick="abrirModalCompletar(<%= sol.id %>)" style="background: #3b82f6; color: white; font-weight: bold; border: none; padding: 7px 14px; border-radius: 6px; cursor: pointer;">
                        🔧 Registrar Ejecución
                    </button>
                <% } %>
            </td>
        </tr>
        <% }); %>
    </table>
</div>
<% } %>

<!-- ========================================================================= -->
<!-- 2. BANDEJA DE TAREAS ASIGNADAS / PENDIENTES ('NO REALIZADO')               -->
<!-- ========================================================================= -->
<div class="card" style="border-left: 5px solid #f59e0b; margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
        <h2 style="margin: 0; font-size: 1.2rem;">📌 <%= esAdmin ? 'Tareas de Mantenimiento Asignadas / Pendientes' : 'Mis Tareas Pendientes Asignadas' %> (<%= tareasPendientes.length %>)</h2>
        <span style="font-size: 0.85rem; color: var(--text-muted);">
            <%= esAdmin ? 'Tareas programadas para el mecánico pendientes de ejecución' : 'Tareas asignadas por Administración para realizar en planta' %>
        </span>
    </div>

    <% if (tareasPendientes.length === 0) { %>
        <p style="margin: 0; color: var(--text-muted); font-size: 0.95rem;">🎉 No hay tareas de mantenimiento pendientes en este momento.</p>
    <% } else { %>
    <table>
        <tr>
            <th>Nº Mtto (Máq.)</th>
            <th>Fecha Límite / Prog.</th>
            <th>Máquina</th>
            <th>Tipo de Tarea</th>
            <th>Responsable</th>
            <th>Instrucciones / Descripción</th>
            <th>Acción</th>
        </tr>
        <% tareasPendientes.forEach(function(t) { %>
        <tr>
            <td><strong># <%= t.nro_maquina || 1 %></strong></td>
            <td>📅 <%= t.fecha %><br><small><%= t.hora %></small></td>
            <td><strong><%= t.maquina %></strong></td>
            <td>
                <% if (t.tipo === 'Preventivo') { %> 🟢 Preventivo
                <% } else if (t.tipo === 'Correctivo') { %> 🔴 Correctivo
                <% } else { %> 🔵 <%= t.tipo %> <% } %>
            </td>
            <td style="text-transform: capitalize;"><%= t.hecho_por %></td>
            <td style="max-width: 340px;"><%= t.descripcion %></td>
            <td>
                <button type="button" onclick="abrirModalCompletar(<%= t.id %>)" style="background: #10b981; color: black; font-weight: bold; border: none; padding: 7px 14px; border-radius: 6px; cursor: pointer;">
                    ✔ Marcar Realizado
                </button>
            </td>
        </tr>
        <% }); %>
    </table>
    <% } %>
</div>

<!-- ========================================================================= -->
<!-- 3. FORMULARIO PRINCIPAL (CREAR ORDEN / ASIGNAR TAREA / SOLICITAR CORRECTIVO) -->
<!-- ========================================================================= -->
<h2><%= esAdmin ? 'Generar Orden de Trabajo o Asignar Tarea a Mecánico' : 'Registrar Mantenimiento o Solicitar Correctivo' %></h2>
<form action="/registrar_mantenimiento" method="POST" class="card" style="border-left: 5px solid var(--primary); display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 30px;">
    
    <div>
        <label><strong id="labelFechaForm"><%= esAdmin ? 'Fecha (o Fecha Límite si es tarea):' : 'Fecha:' %></strong></label><br>
        <input type="date" id="inputFechaMtto" name="fecha" required style="width: 100%;">
    </div>
    <div>
        <label><strong>Hora:</strong></label><br>
        <input type="time" id="inputHoraMtto" name="hora" required style="width: 100%;">
    </div>

    <div>
        <label><strong>Máquina / Equipo:</strong></label><br>
        <select name="maquina" class="select2-maquinas" required style="width: 100%; padding: 8px;">
            <option value="">Seleccione o escriba un equipo...</option>
            <% maquinas.forEach(function(m) { %>
                <option value="<%= m.nombre %>"><%= m.nombre %> (<%= m.codigo %>)</option>
            <% }); %>
        </select>
    </div>
    <div>
        <label><strong>Tipo de Actividad / Mantenimiento:</strong></label><br>
        <select name="tipo" id="selectTipoMtto" onchange="actualizarModoFormulario()" style="width: 100%; padding: 8px;">
            <option value="Limpieza Post-Produccion">🔵 Limpieza y Rutina Post-Producción</option>
            <option value="Preventivo">🟢 Mantenimiento Preventivo (Rutina Pesada)</option>
            <option value="Correctivo">🔴 Mantenimiento Correctivo (Alerta / Avería)</option>
        </select>
    </div>

    <!-- Aviso dinámico cuando el mecánico elige Correctivo -->
    <div id="avisoSolicitudCorrectivo" style="display: none; grid-column: span 2; background: rgba(234, 88, 12, 0.12); border-left: 4px solid #ea580c; padding: 12px 16px; border-radius: 8px; color: var(--text-main);">
        <strong>⚠️ Solicitud de Mantenimiento Correctivo:</strong> Al enviar esta orden como mecánico, quedará en estado <b>Pendiente de Aprobación</b> para que el Administrador la autorice antes de ejecutarla.
    </div>

    <div style="grid-column: span 2;">
        <label><strong id="labelDescripcionForm">Descripción del Trabajo / Instrucciones:</strong></label><br>
        <input type="text" name="descripcion" id="inputDescripcionForm" placeholder="Ej: Cambio de rodamientos, limpieza general, falla detectada..." required style="width: 100%;">
    </div>

    <div id="bloqueTiempoForm">
        <label><strong>Tiempo de Parada (Minutos):</strong></label><br>
        <input type="number" name="tiempo_min" placeholder="Ej: 120" value="0" style="width: 100%;">
    </div>
    <div>
        <label><strong>Responsable (Mecánico / Hecho por):</strong></label><br>
        <input type="text" name="hecho_por" list="listaMecanicos" value="<%= !esAdmin ? usuarioActual : 'manolo' %>" placeholder="Ej: manolo" required style="width: 100%;">
        <datalist id="listaMecanicos">
            <option value="manolo">Manuel "Manolo"</option>
            <% if (typeof mecanicos !== 'undefined') { mecanicos.forEach(function(mec) { %>
                <option value="<%= mec.usuario %>"><%= mec.usuario %></option>
            <% }); } %>
        </datalist>
    </div>

    <div id="bloqueCostoMoForm">
        <label><strong>Costo Mano de Obra ($):</strong></label><br>
        <input type="number" step="0.01" name="costo_mo" value="0.00" style="width: 100%;">
    </div>
    <div id="bloqueCostoMatForm">
        <label><strong>Costo de Materiales ($):</strong></label><br>
        <input type="number" step="0.01" name="costo_mat" value="0.00" style="width: 100%;">
    </div>

    <% if (esAdmin) { %>
    <div style="grid-column: span 2;">
        <label><strong>Modalidad / Estado de la Orden:</strong></label><br>
        <select name="estado" id="selectEstadoMtto" onchange="actualizarModoFormulario()" style="width: 100%; padding: 8px; font-weight: bold;">
            <option value="NO REALIZADO">📌 ASIGNAR TAREA PENDIENTE AL MECÁNICO (Por Realizar)</option>
            <option value="REALIZADO">✔ REGISTRAR COMO YA REALIZADO</option>
        </select>
    </div>
    <% } else { %>
        <input type="hidden" name="estado" id="selectEstadoMtto" value="REALIZADO">
    <% } %>

    <div style="grid-column: span 2; margin-top: 10px;">
        <button type="submit" id="btnSubmitMtto" class="premium-btn" style="background: var(--primary); color: black; font-weight: bold; width: 100%; padding: 12px; font-size: 16px;">
            💾 Guardar Orden de Trabajo
        </button>
    </div>
</form>

<hr>

<!-- ========================================================================= -->
<!-- 4. HISTORIAL GENERAL DE ÓRDENES DE TRABAJO                                -->
<!-- ========================================================================= -->
<h2>Historial de Órdenes de Trabajo</h2>

<div class="card" style="margin-bottom: 20px; display: flex; align-items: center; gap: 15px;">
    <strong>🔎 Buscar mantenimiento: </strong>
    <input type="text" id="inputBusqueda" placeholder="Buscar por máquina, responsable, estado o fecha..." style="flex: 1; max-width: 400px; background: transparent;">
</div>

<table>
    <tr>
        <th>Nº Mtto (Máq.)</th>
        <th>Fecha / Hora</th>
        <th>Máquina</th>
        <th>Tipo</th>
        <th>Responsable</th>
        <th>Tiempos y Costos</th>
        <th>Status</th>
    </tr>

    <% mantenimientos.forEach(function(mtto) { %>
    <tr class="fila-mtto" onclick="verDetalleMtto(<%= mtto.id %>)" style="cursor:pointer;" title="Click para ver detalle completo">
        <td><strong># <%= mtto.nro_maquina || 1 %></strong></td>
        <td><%= mtto.fecha %><br><small><%= mtto.hora %></small></td>
        <td style="text-transform: capitalize;"><strong><%= mtto.maquina %></strong></td>
        <td>
            <% if (mtto.tipo === 'Preventivo') { %> 🟢 Preventivo 
            <% } else if (mtto.tipo === 'Correctivo') { %> 🔴 Correctivo
            <% } else { %> 🔵 <%= mtto.tipo %> <% } %>
        </td>
        <td style="text-transform: capitalize;"><%= mtto.hecho_por %></td>
        <td style="text-align: left; font-size: 14px;">
            ⏱️ <b>Tiempo:</b> <%= mtto.tiempo_min %> min <br>
            💰 $<%= ((mtto.costo_mo || 0) + (mtto.costo_mat || 0)).toLocaleString('es-CO') %> COP total
        </td>
        <td>
            <% if (mtto.estado === 'REALIZADO') { %> 
                <span class="badge-estado badge-realizado">✔ REALIZADO</span> 
            <% } else if (mtto.estado === 'SOLICITADO') { %>
                <span class="badge-estado badge-solicitado">⏳ SOLICITADO</span>
            <% } else if (mtto.estado === 'APROBADO') { %>
                <span class="badge-estado badge-aprobado">✅ APROBADO</span>
            <% } else if (mtto.estado === 'RECHAZADO') { %>
                <span class="badge-estado badge-rechazado">❌ RECHAZADO</span>
            <% } else { %> 
                <span class="badge-estado badge-pendiente">📌 PENDIENTE</span> 
            <% } %>
        </td>
    </tr>
    <% }); %>
</table>

<!-- ========================================================================= -->
<!-- MODAL 1: COMPLETAR TAREA O REGISTRAR EJECUCIÓN DE CORRECTIVO APROBADO     -->
<!-- ========================================================================= -->
<div id="modal-completar-mtto" class="modal-overlay-pic" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal-box-pic" style="max-width: 520px; width: 95%; padding: 28px;">
        <button onclick="document.getElementById('modal-completar-mtto').style.display='none'" style="position:absolute; top:12px; right:16px; background:none; border:none; font-size:22px; cursor:pointer; color:#666;">✖</button>
        <h2 style="margin-top: 0; color: var(--text-main);" id="titulo-modal-completar">✔ Completar Orden #</h2>
        <p id="subtitulo-modal-completar" style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 18px;"></p>

        <form id="form-completar-mtto" method="POST" action="" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div>
                <label><strong>Tiempo de Parada (Minutos):</strong></label>
                <input type="number" name="tiempo_min" id="comp-tiempo" value="60" required style="width: 100%;">
            </div>
            <div>
                <label><strong>Ejecutado por:</strong></label>
                <input type="text" name="hecho_por" id="comp-hecho-por" value="<%= usuarioActual %>" required style="width: 100%;">
            </div>
            <div>
                <label><strong>Costo Mano de Obra ($):</strong></label>
                <input type="number" step="0.01" name="costo_mo" id="comp-costo-mo" value="0" style="width: 100%;">
            </div>
            <div>
                <label><strong>Costo Materiales ($):</strong></label>
                <input type="number" step="0.01" name="costo_mat" id="comp-costo-mat" value="0" style="width: 100%;">
            </div>
            <div style="grid-column: span 2;">
                <label><strong>Notas de cierre / Trabajo realizado (Opcional):</strong></label>
                <input type="text" name="notas_cierre" placeholder="Ej: Se reemplazó pieza y quedó operativa..." style="width: 100%;">
            </div>
            <div style="grid-column: span 2; margin-top: 8px;">
                <button type="submit" class="premium-btn" style="background: #10b981; color: black; font-weight: bold; width: 100%; padding: 12px;">
                    ✔ Confirmar y Marcar como REALIZADO
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: APROBAR O RECHAZAR SOLICITUD DE CORRECTIVO (SOLO ADMIN)          -->
<!-- ========================================================================= -->
<div id="modal-responder-solicitud" class="modal-overlay-pic" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal-box-pic" style="max-width: 480px; width: 95%; padding: 28px;">
        <button onclick="document.getElementById('modal-responder-solicitud').style.display='none'" style="position:absolute; top:12px; right:16px; background:none; border:none; font-size:22px; cursor:pointer; color:#666;">✖</button>
        <h2 style="margin-top: 0; color: var(--text-main);" id="titulo-modal-respuesta">Responder Solicitud</h2>
        <p id="subtitulo-modal-respuesta" style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;"></p>

        <form id="form-responder-solicitud" method="POST" action="">
            <input type="hidden" name="decision" id="input-decision-admin" value="APROBADO">
            <div style="margin-bottom: 16px;">
                <label><strong>Comentario / Instrucción de Administración (Opcional):</strong></label>
                <input type="text" name="comentario_admin" id="input-comentario-admin" placeholder="Ej: Autorizado comprar repuesto / Rechazado por..." style="width: 100%;">
            </div>
            <button type="submit" id="btn-confirmar-respuesta" class="premium-btn" style="width: 100%; padding: 12px; font-weight: bold;">
                Confirmar
            </button>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 3: DETALLE ORDEN DE TRABAJO                                         -->
<!-- ========================================================================= -->
<div id="modal-detalle-mtto" class="modal-overlay-pic" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal-box-pic" style="max-width:650px; width:95%; max-height:90vh; overflow-y:auto; padding: 30px;">
        <button onclick="document.getElementById('modal-detalle-mtto').style.display='none'" style="position:absolute; top:12px; right:16px; background:none; border:none; font-size:22px; cursor:pointer; color:#666;">✖</button>
        
        <div style="border-bottom:3px solid var(--primary); margin-bottom:20px; padding-bottom:12px;">
            <h2 style="margin:0; color:var(--text-main);" id="mtto-titulo">📋 Orden de Trabajo #</h2>
            <span id="mtto-estado-badge" style="font-size:14px; font-weight:bold;"></span>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px;">
            <div style="background:#f8fafc; padding:12px; border-radius:8px;">
                <div style="font-size:11px; color:#888; text-transform:uppercase; margin-bottom:4px;">Máquina / Equipo</div>
                <div style="font-size:18px; font-weight:bold; color:#111;" id="mtto-maquina">—</div>
            </div>
            <div style="background:#f8fafc; padding:12px; border-radius:8px;">
                <div style="font-size:11px; color:#888; text-transform:uppercase; margin-bottom:4px;">Tipo de Mantenimiento</div>
                <div style="font-size:16px; font-weight:bold;" id="mtto-tipo">—</div>
            </div>
            <div style="background:#f8fafc; padding:12px; border-radius:8px;">
                <div style="font-size:11px; color:#888; text-transform:uppercase; margin-bottom:4px;">Fecha y Hora</div>
                <div style="font-size:16px; font-weight:bold; color:#374151;" id="mtto-fecha">—</div>
            </div>
            <div style="background:#f8fafc; padding:12px; border-radius:8px;">
                <div style="font-size:11px; color:#888; text-transform:uppercase; margin-bottom:4px;">Responsable</div>
                <div style="font-size:16px; font-weight:bold; color:#374151;" id="mtto-hecho-por">—</div>
            </div>
        </div>

        <div style="background:#eff6ff; border-left:4px solid #2563eb; padding:14px; border-radius:0 8px 8px 0; margin-bottom:20px;">
            <div style="font-size:11px; color:#1d4ed8; text-transform:uppercase; margin-bottom:6px; font-weight:bold;">📝 Descripción del Trabajo</div>
            <div style="font-size:15px; color:#1e3a5f; line-height:1.6;" id="mtto-descripcion">—</div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
            <div style="background:#f0fdf4; padding:12px; border-radius:8px; text-align:center;">
                <div style="font-size:11px; color:#15803d; text-transform:uppercase;">⏱️ Tiempo Parada</div>
                <div style="font-size:22px; font-weight:bold; color:#166534;" id="mtto-tiempo">—</div>
                <div style="font-size:11px; color:#6b7280;">minutos</div>
            </div>
            <div style="background:#fefce8; padding:12px; border-radius:8px; text-align:center;">
                <div style="font-size:11px; color:#92400e; text-transform:uppercase;">👷 Costo M.O.</div>
                <div style="font-size:18px; font-weight:bold; color:#78350f;" id="mtto-costo-mo">—</div>
            </div>
            <div style="background:#fef2f2; padding:12px; border-radius:8px; text-align:center;">
                <div style="font-size:11px; color:#991b1b; text-transform:uppercase;">⚙️ Costo Materiales</div>
                <div style="font-size:18px; font-weight:bold; color:#7f1d1d;" id="mtto-costo-mat">—</div>
            </div>
        </div>

        <div style="margin-top:16px; text-align:right; padding-top:12px; border-top:1px solid #e5e7eb;">
            <strong style="font-size:16px;">Total: <span id="mtto-costo-total" style="color:#111;">—</span></strong>
        </div>
    </div>
</div>

<!-- Datos JSON de todos los mantenimientos para los modales -->
<script>
    const MTTOS_DATA = <%- JSON.stringify(mantenimientos) %>;
    const ES_ADMIN = <%= esAdmin ? 'true' : 'false' %>;

    function actualizarModoFormulario() {
        const tipo = document.getElementById('selectTipoMtto').value;
        const estadoEl = document.getElementById('selectEstadoMtto');
        const aviso = document.getElementById('avisoSolicitudCorrectivo');
        const btnSubmit = document.getElementById('btnSubmitMtto');

        if (!ES_ADMIN && tipo === 'Correctivo') {
            aviso.style.display = 'block';
            btnSubmit.textContent = '📨 Enviar Solicitud de Correctivo al Admin';
            btnSubmit.style.background = '#ea580c';
            btnSubmit.style.color = 'white';
        } else if (ES_ADMIN && estadoEl && estadoEl.value === 'NO REALIZADO') {
            aviso.style.display = 'none';
            btnSubmit.textContent = '📌 Asignar Tarea al Mecánico';
            btnSubmit.style.background = 'var(--primary)';
            btnSubmit.style.color = 'black';
        } else {
            aviso.style.display = 'none';
            btnSubmit.textContent = '💾 Guardar Orden de Trabajo';
            btnSubmit.style.background = 'var(--primary)';
            btnSubmit.style.color = 'black';
        }
    }

    function abrirModalCompletar(id) {
        const m = MTTOS_DATA.find(x => x.id === id);
        if (!m) return;

        const nro = m.nro_maquina || 1;
        document.getElementById('titulo-modal-completar').textContent = `✔ Completar Mantenimiento #${nro} (${m.maquina})`;
        document.getElementById('subtitulo-modal-completar').textContent = `${m.tipo}: "${m.descripcion}"`;
        document.getElementById('form-completar-mtto').action = `/mantenimiento/completar/${m.id}`;
        document.getElementById('comp-tiempo').value = m.tiempo_min || 60;
        document.getElementById('comp-costo-mo').value = m.costo_mo || 0;
        document.getElementById('comp-costo-mat').value = m.costo_mat || 0;

        document.getElementById('modal-completar-mtto').style.display = 'flex';
    }

    function abrirModalRespuesta(id, nroMaquina, maquina, decision) {
        document.getElementById('form-responder-solicitud').action = `/mantenimiento/responder_solicitud/${id}`;
        document.getElementById('input-decision-admin').value = decision;
        document.getElementById('input-comentario-admin').value = '';

        const titulo = document.getElementById('titulo-modal-respuesta');
        const subtitulo = document.getElementById('subtitulo-modal-respuesta');
        const btn = document.getElementById('btn-confirmar-respuesta');

        if (decision === 'APROBADO') {
            titulo.textContent = `✅ Aprobar Correctivo #${nroMaquina} (${maquina})`;
            subtitulo.textContent = `Autorizar intervención correctiva para la máquina: ${maquina}`;
            btn.textContent = '✅ Confirmar Aprobación';
            btn.style.background = '#10b981';
            btn.style.color = 'black';
        } else {
            titulo.textContent = `❌ Rechazar Correctivo #${nroMaquina} (${maquina})`;
            subtitulo.textContent = `Indica el motivo por el cual se rechaza la solicitud en: ${maquina}`;
            btn.textContent = '❌ Confirmar Rechazo';
            btn.style.background = '#ef4444';
            btn.style.color = 'white';
        }

        document.getElementById('modal-responder-solicitud').style.display = 'flex';
    }

    function verDetalleMtto(id) {
        const m = MTTOS_DATA.find(x => x.id === id);
        if (!m) return;

        const nro = m.nro_maquina || 1;
        document.getElementById('mtto-titulo').textContent = `📋 Mantenimiento #${nro} — ${m.maquina}`;
        
        const badge = document.getElementById('mtto-estado-badge');
        if (m.estado === 'REALIZADO') {
            badge.textContent = '✔ REALIZADO';
            badge.style.color = '#15803d';
        } else if (m.estado === 'SOLICITADO') {
            badge.textContent = '⏳ SOLICITUD PENDIENTE DE APROBACIÓN';
            badge.style.color = '#ea580c';
        } else if (m.estado === 'APROBADO') {
            badge.textContent = '✅ APROBADO POR ADMIN (LISTO PARA EJECUTAR)';
            badge.style.color = '#2563eb';
        } else if (m.estado === 'RECHAZADO') {
            badge.textContent = '❌ SOLICITUD RECHAZADA';
            badge.style.color = '#dc2626';
        } else {
            badge.textContent = '📌 TAREA PENDIENTE';
            badge.style.color = '#d97706';
        }

        document.getElementById('mtto-maquina').textContent   = m.maquina;
        document.getElementById('mtto-tipo').textContent       = m.tipo === 'Preventivo' ? '🟢 Preventivo' : m.tipo === 'Correctivo' ? '🔴 Correctivo' : `🔵 ${m.tipo}`;
        document.getElementById('mtto-fecha').textContent      = `${m.fecha} — ${m.hora}`;
        document.getElementById('mtto-hecho-por').textContent  = m.hecho_por;
        document.getElementById('mtto-descripcion').textContent = m.descripcion;
        document.getElementById('mtto-tiempo').textContent     = m.tiempo_min;
        document.getElementById('mtto-costo-mo').textContent   = `$${(m.costo_mo||0).toLocaleString('es-CO')}`;
        document.getElementById('mtto-costo-mat').textContent  = `$${(m.costo_mat||0).toLocaleString('es-CO')}`;
        const total = (m.costo_mo||0) + (m.costo_mat||0);
        document.getElementById('mtto-costo-total').textContent = `$${total.toLocaleString('es-CO')} COP`;

        const modal = document.getElementById('modal-detalle-mtto');
        modal.style.display = 'flex';
    }

    // Inicialización del Motor Inteligente de Búsqueda de Máquinas y Fecha/Hora por defecto
    $(document).ready(function() {
        $('.select2-maquinas').select2({
            placeholder: "🔍 Escriba el nombre o código...",
            allowClear: true,
            width: '100%'
        });

        const inputFecha = document.getElementById('inputFechaMtto');
        const inputHora = document.getElementById('inputHoraMtto');
        if (inputFecha && !inputFecha.value) {
            const ahora = new Date();
            const yyyy = ahora.getFullYear();
            const mm = String(ahora.getMonth() + 1).padStart(2, '0');
            const dd = String(ahora.getDate()).padStart(2, '0');
            inputFecha.value = `${yyyy}-${mm}-${dd}`;
        }
        if (inputHora && !inputHora.value) {
            const ahora = new Date();
            const hh = String(ahora.getHours()).padStart(2, '0');
            const min = String(ahora.getMinutes()).padStart(2, '0');
            inputHora.value = `${hh}:${min}`;
        }

        actualizarModoFormulario();
    });

    document.getElementById('inputBusqueda').addEventListener('keyup', function() {
        let textoBusqueda = this.value.toLowerCase();
        let filas = document.querySelectorAll('.fila-mtto');
        filas.forEach(fila => {
            fila.style.display = fila.innerText.toLowerCase().includes(textoBusqueda) ? '' : 'none';
        });
    });
</script>

<%- include('../partials/footer') %>
