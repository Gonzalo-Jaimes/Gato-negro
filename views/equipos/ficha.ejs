<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha Técnica: <%= maquina.nombre %></title>
    <script>
        if (localStorage.getItem('gato-dark-mode') === 'true') {
            document.documentElement.classList.add('dark-mode');
        }
    </script>
    <!-- Sistema de Diseño v4.0 · Artesanal tabaquero -->
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        body {
            font-family: var(--font-main);
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            padding: 28px 20px;
        }
        .topbar-ficha {
            max-width: 820px;
            margin: 0 auto 14px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .btn-tema {
            background: var(--bg-card);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 8px 14px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-tema:hover {
            background: var(--primary-soft);
            color: var(--primary);
        }
        .ficha-container {
            max-width: 820px;
            margin: auto;
            background: var(--bg-card);
            padding: 32px;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-color);
            border-top: 6px solid var(--primary);
        }
        .header-excel {
            display: flex;
            border: 2px solid var(--secondary);
            border-radius: var(--radius-sm) var(--radius-sm) 0 0;
            background: var(--bg-card);
            margin-bottom: 0;
            align-items: stretch;
            overflow: hidden;
        }
        .header-excel .logo-box {
            width: 220px;
            border-right: 2px solid var(--secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
            background: #1F1912;
        }
        .header-excel .logo-box img { max-width: 100%; max-height: 86px; }
        .header-excel .info-box {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 14px;
            font-family: var(--font-head);
            font-size: 15px;
            font-weight: 700;
            line-height: 1.35;
            color: var(--text-main);
        }
        .title-excel {
            border: 2px solid var(--secondary);
            border-top: none;
            border-radius: 0 0 var(--radius-sm) var(--radius-sm);
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            text-align: center;
            padding: 10px;
            font-weight: 700;
            font-family: var(--font-head);
            color: var(--on-primary);
            margin-bottom: 24px;
            font-size: 14px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .datos-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 30px;
            background: var(--bg-main);
            padding: 22px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        /* COMPATIBILIDAD CON CELULARES */
        @media (max-width: 600px) { 
            body { padding: 12px; }
            .ficha-container { padding: 16px; }
            .header-excel { flex-direction: column; align-items: center; }
            .header-excel .logo-box { width: 100%; border-right: none; border-bottom: 2px solid var(--secondary); padding: 12px 0; }
            .header-excel .info-box span { font-size: 12px; }
            .datos-grid { grid-template-columns: 1fr; } 
            .historial-title { flex-direction: column; gap: 10px; text-align: center; }
        }
        
        .dato-item strong {
            display: block;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 3px;
        }
        .dato-item span {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-main);
        }
        
        .historial-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .historial-title h2 {
            margin: 0;
            font-size: 20px;
            color: var(--text-main);
        }
        .badge-contador {
            background: var(--primary-soft);
            color: var(--primary);
            border: 1px solid var(--border-color);
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }
        
        .mtto-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--secondary);
            padding: 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
        }
        .mtto-card.preventivo { border-left-color: var(--success); }
        .mtto-card.correctivo { border-left-color: var(--danger); }
        
        .mtto-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 14px;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 8px;
        }
        .mtto-header strong { color: var(--text-main); }
        .mtto-desc {
            font-size: 15px;
            margin-bottom: 12px;
            color: var(--text-main);
            line-height: 1.5;
        }
        .mtto-footer {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: space-between;
            font-size: 13px;
            color: var(--text-muted);
            background: var(--bg-main);
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }
        .mtto-footer strong { color: var(--text-main); }
        
        .btn-imprimir {
            display: block;
            width: 100%;
            padding: 15px;
            background: var(--primary);
            color: var(--on-primary);
            text-align: center;
            text-decoration: none;
            font-weight: 700;
            font-family: var(--font-head);
            border-radius: var(--radius-sm);
            margin-top: 30px;
            cursor: pointer;
            border: none;
            font-size: 16px;
            transition: background 0.2s, box-shadow 0.2s;
        }
        .btn-imprimir:hover {
            background: var(--primary-hover);
            box-shadow: var(--shadow-md);
        }
        
        @media print {
            body { background: white !important; color: #000 !important; padding: 0; }
            .topbar-ficha, .btn-imprimir { display: none !important; }
            .ficha-container { box-shadow: none !important; border: 1px solid #000 !important; border-top: 4px solid #000 !important; padding: 0; max-width: 100%; background: white !important; }
            .header-excel { border-color: #000 !important; background: white !important; }
            .header-excel .info-box { color: #000 !important; }
            .title-excel { background: #e5e7eb !important; color: #000 !important; border-color: #000 !important; }
            .datos-grid, .mtto-card, .mtto-footer { background: white !important; border-color: #ccc !important; color: #000 !important; }
            .dato-item span, .dato-item strong, .mtto-desc, .mtto-header, .mtto-footer, .mtto-footer strong { color: #000 !important; }
            .mtto-card, .datos-grid, .header-excel, img { page-break-inside: avoid; break-inside: avoid; }
        }
    </style>
    <script>
        function toggleTemaFicha() {
            document.documentElement.classList.toggle('dark-mode');
            localStorage.setItem('gato-dark-mode', document.documentElement.classList.contains('dark-mode'));
        }
    </script>
</head>
<body>

<div class="topbar-ficha">
    <a href="/maquinas" class="btn-tema" style="text-decoration: none;">⬅ Volver a Máquinas</a>
    <button class="btn-tema" onclick="toggleTemaFicha()">🌓 Cambiar Tema</button>
</div>

<div class="ficha-container">
    <!-- Encabezado Corporativo con Paleta Artesanal Tabaquera v4.0 -->
    <div class="header-excel">
        <div class="logo-box">
            <img src="/img/logo.png" alt="Gato Negro Logo">
        </div>
        <div class="info-box">
            <span>FÁBRICA DE TABACOS GATO NEGRO</span>
            <span>RIF. V- 06676738-4 GONZALO JAIMES BASTOS</span>
            <span>CARRERA 14 CASA N° 13-47 SECTOR PINTO SALINAS</span>
            <span>SAN ANTONIO ESTADO TÁCHIRA</span>
        </div>
    </div>
    
    <div class="title-excel">
        DATOS GENERALES DE LA MÁQUINA / EQUIPO
    </div>

    <% if (maquina.imagen) { %>
    <div style="text-align: center; margin-bottom: 22px; background: var(--bg-main); padding: 12px; border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
        <img src="/img/<%= maquina.imagen %>" alt="Foto de <%= maquina.nombre %>" style="max-width: 100%; max-height: 400px; border-radius: 6px;">
    </div>
    <% } %>

    <div class="datos-grid">
        <div class="dato-item"><strong>Nombre del Equipo</strong><span><%= maquina.nombre %></span></div>
        <div class="dato-item"><strong>Código Asignado</strong><span><%= maquina.codigo %></span></div>
        <div class="dato-item"><strong>Marca / Modelo</strong><span><%= maquina.marca %> - <%= maquina.modelo %></span></div>
        <div class="dato-item"><strong>Fabricante</strong><span><%= maquina.fabricante %></span></div>
        <div class="dato-item"><strong>Área / Ubicación</strong><span><%= maquina.area %></span></div>
        <div class="dato-item"><strong>Horas de Trabajo / Día</strong><span><%= maquina.horas_dia %> hrs</span></div>
        <div class="dato-item"><strong>Estado Actual</strong>
            <% if (maquina.estado === 'Funcional') { %>
                <span style="color: var(--success); font-weight: 700;">🟢 <%= maquina.estado %></span>
            <% } else if (maquina.estado === 'No Funcional') { %>
                <span style="color: var(--danger); font-weight: 700;">🔴 <%= maquina.estado %></span>
            <% } else { %>
                <span style="color: var(--warning); font-weight: 700;">🟡 <%= maquina.estado %></span>
            <% } %>
        </div>
        <div class="dato-item"><strong>Frecuencia Mtto.</strong><span>Cada <%= maquina.frecuencia_mtto_dias || 30 %> días</span></div>
        <div class="dato-item" style="grid-column: 1 / -1;"><strong>Observaciones</strong><span><%= maquina.observaciones || 'Ninguna' %></span></div>
    </div>

    <div class="historial-title">
        <h2>📋 Historial Clínico (Mantenimientos)</h2>
        <span class="badge-contador"><%= historial.length %> Registros</span>
    </div>

    <% if (historial.length === 0) { %>
        <p style="text-align: center; color: var(--text-muted); padding: 24px; background: var(--bg-main); border-radius: var(--radius-sm); border: 1px dashed var(--border-color);">
            Este equipo no tiene mantenimientos realizados en su hoja de vida aún.
        </p>
    <% } else { %>
        <% historial.forEach(function(mtto) { %>
            <div class="mtto-card <%= mtto.tipo === 'Preventivo' ? 'preventivo' : (mtto.tipo === 'Correctivo' ? 'correctivo' : '') %>">
                <div class="mtto-header">
                    <strong>
                        #<%= mtto.nro_maquina || 1 %> — <% if (mtto.tipo === 'Preventivo') { %> 🟢 Preventivo <% } else if (mtto.tipo === 'Correctivo') { %> 🔴 Correctivo <% } else { %> 🔵 <%= mtto.tipo %> <% } %>
                    </strong>
                    <span>📅 <%= mtto.fecha %> a las <%= mtto.hora %></span>
                </div>
                
                <div class="mtto-desc">
                    <strong>Trabajo Realizado:</strong> <%= mtto.descripcion %>
                </div>
                
                <div class="mtto-footer">
                    <span>👷 Por: <strong><%= mtto.hecho_por %></strong></span>
                    <span>⏱️ Tiempo: <strong><%= mtto.tiempo_min %> min</strong></span>
                    <% if (session && session.rol === 'admin') { %>
                        <span>💸 Costo: <strong>$<%= ((parseFloat(mtto.costo_mo) || 0) + (parseFloat(mtto.costo_mat) || 0)).toLocaleString('es-CO') %> COP</strong></span>
                    <% } %>
                    <% if (mtto.estado === 'REALIZADO') { %>
                        <span style="color: var(--success); font-weight: 700;">✔ <%= mtto.estado %></span>
                    <% } else { %>
                        <span style="color: var(--danger); font-weight: 700;"><%= mtto.estado %></span>
                    <% } %>
                </div>
            </div>
        <% }); %>
    <% } %>

    <button class="btn-imprimir" onclick="window.print()">🖨️ Imprimir Ficha Técnica</button>
</div>

</body>
</html>
