<%- include('../partials/header') %>
<% 
  // Definición de constantes locales (V2.9.9)
  const pesos = [35, 28, 21, 14, 7];
  const colores = { 35: 'saco-35', 28: 'saco-28', 21: 'saco-21', 14: 'saco-14', 7: 'saco-7' };
%>

<style>
.pic-grid     { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
/* Componentes Semánticos v3.1 */
.pic-card     { background: var(--bg-card); border-radius: var(--radius); padding: 22px; border: 1px solid var(--border-color); box-shadow: var(--shadow-sm); }
.pic-card h3  { margin: 0 0 16px 0; font-size: 17px; border-bottom: 2px solid var(--border-color); padding-bottom: 10px; color: var(--text-main); }
.stat-box     { text-align: center; padding: 14px; border-radius: 10px; background: var(--bg-sunken); border: 1px solid var(--border-color); }
.lote-card    { border: 1px solid var(--border-color); border-radius: 10px; padding: 16px; margin-bottom: 12px; background: var(--bg-card); }
.modal-box-pic { background: var(--bg-card); border-radius: 14px; padding: 28px; max-width: 650px; width: 95%; border: 1px solid var(--border-color); box-shadow: var(--shadow-lg); }
/* Sacos disponibles: filtros, grupos por peso y tarjeta de saco */
.sf-barra      { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-3); }
.sf-campo label { display: block; font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-1); color: var(--text-main); }
.sf-campo input, .sf-campo select { width: 100%; box-sizing: border-box; min-height: var(--touch-min); padding: var(--space-2) var(--space-3); font-size: 16px; background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); }
.sf-pesos      { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }
.sf-chip       { min-height: 36px; padding: var(--space-1) var(--space-3); border: 1px solid var(--border-strong); border-radius: var(--radius-full); background: var(--bg-card); color: var(--text-main); font: inherit; font-size: var(--text-sm); cursor: pointer; display: inline-flex; align-items: center; gap: var(--space-2); }
.sf-chip b     { font-variant-numeric: tabular-nums; color: var(--text-muted); font-weight: 600; }
.sf-chip:hover { border-color: var(--primary); background: var(--primary-soft); }
.sf-chip[aria-pressed="true"] { background: var(--primary); border-color: var(--primary); color: var(--on-primary, #fff); }
.sf-chip[aria-pressed="true"] b { color: inherit; }
.sf-resumen    { margin: 0 0 var(--space-3); font-size: var(--text-sm); color: var(--text-muted); font-variant-numeric: tabular-nums; }
.sf-chip:focus-visible, .saco-sel:focus-visible, .btn-dividir:focus-visible, .sf-campo input:focus-visible, .sf-campo select:focus-visible { outline: none; box-shadow: var(--focus-ring); }
.saco-grupo    { margin-top: var(--space-4); }
.saco-grupo h4 { margin: 0 0 var(--space-2); font-size: var(--text-sm); font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: var(--space-2); }
.saco-grid     { display: grid; grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); gap: var(--space-2); }
.saco-item     { display: flex; align-items: stretch; background: var(--bg-sunken); border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; color: var(--text-main); transition: border-color .15s, background .15s; }
.saco-item[hidden], .lote-card[hidden], .saco-grupo[hidden] { display: none !important; }
.saco-item:hover { border-color: var(--primary); }
.saco-sel      { flex: 1; min-width: 0; min-height: var(--touch-min); display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); background: transparent; border: 0; color: inherit; font: inherit; text-align: left; cursor: pointer; }
.saco-sel strong, .saco-sel span { white-space: nowrap; }
.saco-sel span { color: var(--text-muted); }
.saco-sel .ico-ok { width: 16px; height: 16px; flex: none; margin-left: auto; opacity: 0; }
.saco-item.seleccionado { background: var(--primary-soft); border-color: var(--primary); box-shadow: inset 0 0 0 1px var(--primary); }
.saco-item.seleccionado .ico-ok { opacity: 1; color: var(--primary-text); }
.saco-item.seleccionado .saco-sel strong { color: var(--primary-text); }
/* Botón Dividir: caja visible con icono de tijera y texto, para que se lea como acción */
.btn-dividir   { flex: none; display: inline-flex; align-items: center; gap: var(--space-1); margin: var(--space-1); padding: 0 var(--space-3); min-height: 36px; background: var(--bg-card); color: var(--info-text); border: 1px solid var(--border-strong); border-radius: var(--radius-xs); font: inherit; font-size: var(--text-xs); font-weight: 600; cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
.btn-dividir svg { width: 16px; height: 16px; flex: none; }
.btn-dividir:hover { background: var(--info-soft); border-color: var(--info); }
.btn-dividir:active { transform: scale(0.97); }
.lote-resumen  { font-size: var(--text-xs); color: var(--text-muted); }
@media (max-width: 768px) {
    .sf-barra { grid-template-columns: 1fr; }
    .btn-dividir { min-height: var(--touch-min); margin: 0; border-radius: 0; border-width: 0 0 0 1px; }
    .saco-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) { .saco-item, .btn-dividir { transition: none; } }
.inp-qty      { width: 60px; padding: 6px; border: 1px solid var(--border-color); border-radius: 6px; text-align: center; color: var(--text-main); background: var(--bg-card); }

</style>

<h1>📦 Bodega Central de Material</h1>
<h2 class="sr-only">Despacho de material, registro de pesadas y sacos disponibles</h2>
<hr>

<!-- ⚡ RESUMEN DE STOCK ACTUAL (Mejorado v3.2) -->
<div class="pic-grid" style="grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 14px; margin-bottom: 28px;">
    <% 
        const _pesosStock = [35, 28, 21, 14, 7];
        const _conteosStock = {};
        _pesosStock.forEach(p => { _conteosStock[p] = sacosDisponibles.filter(s => s.peso_kg == p).length; });
        const _sobrantesStock = sacosDisponibles.filter(s => s.tipo === 'sobrante').length;
        const _totalStock = sacosDisponibles.length;
        const _kgStock = sacosDisponibles.reduce((acc, s) => acc + parseFloat(s.peso_kg), 0);
    %>
    <div class="stat-box" style="border-top: 4px solid var(--primary-hover);">
        <div class="stat-num" style="color:var(--primary);"><%= _totalStock %></div>
        <div class="stat-lbl">Total Sacos</div>
    </div>
    <div class="stat-box" style="border-top: 4px solid var(--success);">
        <div class="stat-num" style="color:var(--success);"><%= _kgStock.toFixed(0) %> kg</div>
        <div class="stat-lbl">Kg Procesados</div>
    </div>
    <% _pesosStock.forEach(p => { 
        let _colorVal = 'var(--chart-5)';                 /* paleta de gráficas: todas >= 4,5:1 sobre la tarjeta */
        if (p == 35) _colorVal = 'var(--chart-2)';
        else if (p == 28) _colorVal = 'var(--chart-1)';
        else if (p == 21) _colorVal = 'var(--chart-6)';
        else if (p == 14) _colorVal = 'var(--chart-3)';
    %>
    <div class="stat-box">
        <div class="stat-num" style="font-size:26px; color: <%= _colorVal %>;"><%= _conteosStock[p] %></div>
        <div class="stat-lbl"><%= p %> kg</div>
    </div>
    <% }); %>
    <div class="stat-box" style="border-top: 4px solid #9333ea;">
        <div class="stat-num" style="font-size:26px; color:var(--chart-5);"><%= _sobrantesStock %></div>
        <div class="stat-lbl">Sobrantes</div>
    </div>
</div>

<!-- ⚡ MATERIA PRIMA EN ALMACÉN (CONEXIÓN CON INVENTARIO V2.10.1) -->
<div class="card" style="border: 1px solid var(--border-color); padding: 18px; margin-bottom: 28px; background: var(--bg-sunken);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px;">
        <% 
            const getInv = (mat, exclude = ['procesada', 'reserva']) => {
                const item = inventario.find(i => {
                    const m = i.material.toLowerCase();
                    return m.includes(mat.toLowerCase()) && !exclude.some(ex => m.includes(ex));
                });
                return item ? parseFloat(item.cantidad).toFixed(1) : '0.0';
            };
            const getPicaProcesada = () => {
                // Sumar todos los kg de sacas en el inventario global
                return inventario
                    .filter(i => i.material.toLowerCase().includes('saca picadura'))
                    .reduce((acc, i) => acc + parseFloat(i.cantidad || 0) * (parseFloat(i.material.match(/\d+/)) || 0), 0)
                    .toFixed(1);
            };
        %>
        <div class="card" style="padding: 12px; border-left: 4px solid var(--chart-5);">
            <div style="font-size: 11px; color: var(--text-muted); font-weight: bold;">CAPA EN BODEGA</div>
            <div style="font-size: 20px; font-weight: 900; color: var(--chart-5);"><%= getInv('capa') %> <small style="font-size: 12px;">kg</small></div>
        </div>
        <div class="card" style="padding: 12px; border-left: 4px solid var(--primary-hover);">
            <div style="font-size: 11px; color: var(--text-muted); font-weight: bold;">CAPOTE EN BODEGA</div>
            <div style="font-size: 20px; font-weight: 900; color: var(--primary-hover);"><%= getInv('capote') %> <small style="font-size: 12px;">kg</small></div>
        </div>
        <div class="card" style="padding: 12px; border-left: 4px solid var(--success);">
            <div style="font-size: 11px; color: var(--text-muted); font-weight: bold;">PICADURA BRUTA (HOJA)</div>
            <div style="font-size: 20px; font-weight: 900; color: var(--primary);"><%= getInv('picadura', ['saca', 'saco', 'procesada']) %> <small style="font-size: 12px;">kg</small></div>
        </div>
        <div class="card" style="padding: 12px; border-left: 4px solid var(--success);">
            <div style="font-size: 11px; color: var(--text-muted); font-weight: bold;">PICADURA PROCESADA (SACAS)</div>
            <div style="font-size: 20px; font-weight: 900; color: var(--success);"><%= _kgStock.toFixed(1) %> <small style="font-size: 12px;">kg</small></div>
        </div>
    </div>
</div>

<!-- ⚡ PANEL DE DESPACHO ACTIVO (STICKY) -->
<div class="card" style="position: sticky; top: 10px; z-index: 1000; border: 2px solid var(--primary); background: var(--primary-soft); margin-bottom: 28px; backdrop-filter: blur(10px);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
        <span style="font-size: 24px;">📥</span>
        <h3 style="margin: 0; border: none; padding: 0; color: var(--text-main);">Despacho de Material Activo</h3>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 20px; align-items: start;">
        <!-- Paso 1: Fabriquín -->
        <div>
            <label for="sel-empleado-pic" style="font-size:12px; font-weight:bold; color:var(--primary-text); text-transform:uppercase; display:block; margin-bottom:6px;">1. Seleccionar fabriquín</label>
            <select id="sel-empleado-pic" style="font-size:15px; font-weight:bold;" onchange="actualizarMetasMaterial()">
                <option value="">-- ¿A quién entregamos? --</option>
                <% empleados.forEach(emp => { %>
                <option value="<%= emp.id %>"><%= emp.nombre %></option>
                <% }); %>
            </select>
            <div id="status-picadura" style="margin-top:10px; font-size:12px; font-weight:bold; text-align:center; padding:8px; border-radius:8px; min-height: 45px; display: flex; align-items: center; justify-content: center; background: var(--bg-sunken); color: var(--text-muted);">
                ⚠️ Selecciona un trabajador primero.
            </div>
        </div>

        <!-- Paso 2: Metas y Pesos Reales -->
        <div id="bloque-metas" style="opacity: 0.5; pointer-events: none; border-radius: 10px; padding: 15px; border: 1px solid var(--border-color); background: var(--bg-sunken);">
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:15px; text-align:center;">
                <div>
                    <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase;">Meta Picadura</div>
                    <div style="font-size:18px; font-weight:900; color:var(--success);" id="meta-pica">0 kg</div>
                </div>
                <div>
                    <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase;">Meta Capa</div>
                    <div style="font-size:18px; font-weight:900; color:var(--chart-5);" id="meta-capa">0 kg</div>
                </div>
                <div>
                    <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase;">Meta Capote</div>
                    <div style="font-size:18px; font-weight:900; color:var(--primary-hover);" id="meta-capo">0 kg</div>
                </div>
            </div>
            
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div>
                    <label for="real-capa-pic" style="font-size:11px; font-weight:bold; display:block; margin-bottom:4px; color:var(--text-main);">PESO REAL CAPA (kg)</label>
                    <input type="number" id="real-capa-pic" step="0.01" class="touch-input" style="width:100%; border:1px solid var(--border-color); border-radius:6px; font-weight:bold; background:var(--bg-card); color:var(--text-main);">
                </div>
                <div>
                    <label for="real-capote-pic" style="font-size:11px; font-weight:bold; display:block; margin-bottom:4px; color:var(--text-main);">PESO REAL CAPOTE (kg)</label>
                    <input type="number" id="real-capote-pic" step="0.01" class="touch-input" style="width:100%; border:1px solid var(--border-color); border-radius:6px; font-weight:bold; background:var(--bg-card); color:var(--text-main);">
                </div>
            </div>
        </div>

        <!-- Paso 3: Confirmación -->
        <div>
            <div style="font-size:12px; font-weight:bold; color:var(--primary-text); text-transform:uppercase; margin-bottom:6px;">2. Confirmar</div>
            <button onclick="confirmarEntrega()" id="btn-confirmar-pic" class="btn btn-success btn-block touch-target touch-mobile-full">
                ✅ DESPACHAR
            </button>
            <div id="resumen-sacos-sel" style="margin-top:8px; font-size:13px; color:var(--text-main); font-weight: bold; text-align: center;">
                0 bultos seleccionados
            </div>
            <p id="pic-error" style="color:var(--danger); font-size:12px; margin-top:6px; font-weight: bold; text-align: center; display:none;"></p>
        </div>
    </div>
</div>

<div class="pic-grid">

    <!-- COL IZQUIERDA: Registrar nuevo lote -->
    <div>
        <div class="pic-card">
            <h3>⚗️ Registrar Pesada (Lote Nuevo)</h3>
            <form action="/registrar_lote_picadura" method="POST">
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                    <div>
                        <label for="pic-fecha" style="font-size:13px; font-weight:bold; display:block; margin-bottom:4px;">Fecha de la pesada</label>
                        <input type="date" name="fecha" id="pic-fecha" value="<%= new Date().toISOString().slice(0,10) %>" required style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:6px; box-sizing:border-box; background:var(--bg-card); color:var(--text-main);">
                    </div>
                    <div>
                        <label for="pic-kg-entrada" style="font-size:13px; font-weight:bold; display:block; margin-bottom:4px;">Picadura bruta de entrada (kg)</label>
                        <input type="number" name="kg_entrada" id="pic-kg-entrada" step="0.1" min="1" placeholder="Ej: 3000" class="touch-input" required style="width:100%; border:1px solid var(--border-color); border-radius:6px; box-sizing:border-box; background:var(--bg-card); color:var(--text-main);">
                    </div>
                </div>

                <p style="font-size:13px; color:var(--text-muted); margin-bottom:10px;">¿Cuántos sacos de cada tamaño salieron de esta pesada?</p>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px;">
                    <% pesos.forEach(p => { %>
                    <div style="display: flex; align-items: center; gap: 10px; background: var(--bg-sunken); padding: 10px; border-radius: 8px;">
                        <span class="saco-badge <%= colores[p] %>"><%= p %> kg</span>
                        <input type="number" name="sacos_<%= p %>" class="inp-qty" min="0" value="0" placeholder="0" aria-label="Cantidad de sacos de <%= p %> kg">
                    </div>
                    <% }); %>
                    <div style="display: flex; align-items: center; gap: 10px; background: var(--primary-soft); padding: 10px; border-radius: 8px; grid-column: span 2;">
                        <span class="saco-badge saco-sob">Sobrante</span>
                        <span style="font-size: 13px; color: var(--text-muted);">Cantidad:</span>
                        <input type="number" name="sacos_sobrante_qty" class="inp-qty" min="0" value="0" aria-label="Cantidad de sacos sobrantes">
                        <span style="font-size: 13px; color: var(--text-muted);">Peso (kg):</span>
                        <input type="number" name="sacos_sobrante_kg" class="inp-qty" min="0" step="0.1" value="0" placeholder="Ej: 8.5" aria-label="Peso de los sacos sobrantes en kilos">
                    </div>
                </div>

                <!-- Resumen en vivo del calculado -->
                <div id="resumen-calculo" style="background: var(--info-soft); padding: 12px; border-radius: 8px; font-size: 13px; margin-bottom:10px; display:none;">
                    📊 Salida total: <strong id="txt-kg-salida">0</strong> kg — 
                    Diferencia por humedad: <strong id="txt-diferencia" style="color: var(--success);">+0 kg</strong>
                </div>

                <div>
                    <label for="pic-nota" style="font-size:13px; font-weight:bold; display:block; margin-bottom:4px;">Nota <span style="font-weight:400;">(opcional)</span></label>
                    <input type="text" name="nota" id="pic-nota" placeholder="Ej: Lote con humedad alta" style="width:100%; padding:8px; border:1px solid var(--border-color); border-radius:6px; box-sizing:border-box; background:var(--bg-card); color:var(--text-main);">
                </div>
                <button type="submit" class="btn btn-block" style="margin-top: var(--space-4);">💾 Registrar pesada y generar sacos</button>
            </form>
        </div>
    </div>

    <!-- COL DERECHA: sacos disponibles agrupados por peso, con filtros -->
    <div>
        <%
            const _ICO_TIJERA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>';
            const _ICO_OK = '<svg class="ico-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
            const _lotesConSacos = lotes.filter(l => sacosDisponibles.some(s => s.lote_id === l.id));
            const _cntPeso = {};
            [35,28,21,14,7].forEach(p => { _cntPeso[p] = sacosDisponibles.filter(s => s.tipo !== 'sobrante' && parseFloat(s.peso_kg) === p).length; });
            const _cntSob = sacosDisponibles.filter(s => s.tipo === 'sobrante').length;
        %>
        <div class="pic-card">
            <h3>📦 Sacos Disponibles por Lote</h3>
            <% if (lotes.length === 0) { %>
                <p style="color: var(--text-muted); text-align: center; padding: 20px;">Sin lotes registrados aún.</p>
            <% } else { %>

                <% if (sacosDisponibles.length > 0) { %>
                <div class="sf-barra" role="search" aria-label="Filtrar sacos disponibles">
                    <div class="sf-campo">
                        <label for="sf-buscar">Buscar por número de saco</label>
                        <input type="search" id="sf-buscar" inputmode="numeric" autocomplete="off" placeholder="Ej: 12" aria-describedby="sf-ayuda">
                    </div>
                    <div class="sf-campo">
                        <label for="sf-lote">Pesada</label>
                        <select id="sf-lote">
                            <option value="">Todas las pesadas</option>
                            <% _lotesConSacos.forEach(l => { %>
                            <option value="<%= l.id %>">Pesada <%= l.fecha %> (<%= sacosDisponibles.filter(s => s.lote_id === l.id).length %> sacos)</option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <p id="sf-ayuda" class="lote-resumen" style="margin: -4px 0 var(--space-3);">Los números se repiten en cada pesada: combine la búsqueda con el filtro de pesada.</p>

                <div class="sf-pesos" role="group" aria-label="Filtrar por peso">
                    <button type="button" class="sf-chip" data-peso="" aria-pressed="true">Todos <b><%= sacosDisponibles.length %></b></button>
                    <% [35,28,21,14,7].forEach(p => { if (_cntPeso[p] > 0) { %>
                    <button type="button" class="sf-chip" data-peso="<%= p %>" aria-pressed="false"><%= p %> kg <b><%= _cntPeso[p] %></b></button>
                    <% } }); %>
                    <% if (_cntSob > 0) { %>
                    <button type="button" class="sf-chip" data-peso="sob" aria-pressed="false">Sobrantes <b><%= _cntSob %></b></button>
                    <% } %>
                </div>
                <p class="sf-resumen" id="sf-resumen" role="status" aria-live="polite">Mostrando <%= sacosDisponibles.length %> de <%= sacosDisponibles.length %> sacos</p>
                <% } %>

                <% lotes.forEach(lote => {
                    const sacosLote = sacosDisponibles.filter(s => s.lote_id === lote.id);
                    if (sacosLote.length === 0 && lote.estado === 'agotado') {
                %>
                    <div class="lote-card agotado lote-agotado">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong>Pesada <%= lote.fecha %></strong>
                            <span style="font-size:11px; background:var(--bg-sunken); padding:3px 8px; border-radius:10px; color:var(--text-muted);">✅ Agotada</span>
                        </div>
                        <div class="lote-resumen" style="margin-top:4px;"><%= lote.kg_entrada %> kg entrada → <%= lote.kg_salida %> kg salida</div>
                    </div>
                <%  } else if (sacosLote.length > 0) {
                        const _pesosLote = [...new Set(sacosLote.map(s => parseFloat(s.peso_kg)))].sort((a, b) => b - a);
                %>
                    <div class="lote-card activo" data-lote="<%= lote.id %>">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap: var(--space-3);">
                            <div>
                                <strong style="font-size:15px;">Pesada <%= lote.fecha %></strong>
                                <div class="lote-resumen"><%= lote.kg_entrada %> kg bruta → <%= lote.kg_salida %> kg procesada (+<%= (lote.kg_salida - lote.kg_entrada).toFixed(1) %> kg humedad)</div>
                            </div>
                            <span style="font-size:13px; font-weight:bold; color:var(--success-text); white-space:nowrap;"><%= sacosLote.length %> sacos</span>
                        </div>
                        <% _pesosLote.forEach(peso => {
                            const grupo = sacosLote.filter(s => parseFloat(s.peso_kg) === peso).sort((a, b) => a.numero_saco - b.numero_saco);
                            const esSob = grupo.every(s => s.tipo === 'sobrante');
                        %>
                        <div class="saco-grupo">
                            <h4><span class="saco-badge <%= esSob ? 'saco-sob' : (colores[peso] || 'saco-sob') %>"><%= peso %> kg</span> <%= grupo.length %> <%= grupo.length === 1 ? 'saco' : 'sacos' %><%= esSob ? ' (sobrantes)' : '' %></h4>
                            <div class="saco-grid">
                                <% grupo.forEach(s => { %>
                                <div class="saco-item" data-saco-id="<%= s.id %>" data-kg="<%= s.peso_kg %>" data-lote="<%= lote.id %>" data-num="<%= s.numero_saco %>" data-tipo="<%= s.tipo %>">
                                    <button type="button" class="saco-sel" aria-pressed="false" onclick="toggleSaco(this.closest('.saco-item'))">
                                        <strong>#<%= s.numero_saco %></strong>
                                        <span style="font-size:12px;"><%= s.peso_kg %> kg<%= s.tipo === 'sobrante' ? ' ⭐' : '' %></span>
                                        <%- _ICO_OK %>
                                    </button>
                                    <button type="button" class="btn-dividir" aria-label="Dividir el saco <%= s.numero_saco %> de <%= s.peso_kg %> kg en sacos menores"
                                            onclick="abrirDivision('<%= s.id %>','<%= s.numero_saco %>', <%= s.peso_kg || 0 %>)">
                                        <%- _ICO_TIJERA %><span>Dividir</span>
                                    </button>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                <% } }); %>

                <p id="sf-vacio" hidden style="text-align:center; padding: var(--space-6) 0; color: var(--text-muted);">
                    Ningún saco coincide con los filtros.
                    <button type="button" class="btn btn-ghost btn-sm" id="sf-limpiar" style="margin-left: var(--space-2);">Quitar filtros</button>
                </p>
            <% } %>
        </div>
    </div>
</div>

<!-- HISTORIAL DE ENTREGAS RECIENTES -->
<div class="pic-card" style="margin-bottom: 24px;">
    <h3>📋 Entregas Recientes de Sacas</h3>
    <% if (sacosEntregados.length === 0) { %>
        <p style="color: var(--text-muted);">Sin entregas registradas.</p>
    <% } else { %>
    <table>
        <tr>
            <th>Fecha</th>
            <th>Fabriquín</th>
            <th>Lote</th>
            <th>Sacos Entregados</th>
            <th>Total kg</th>
        </tr>
        <% 
            // Agrupar por empleado + fecha
            const entregasMapa = {};
            sacosEntregados.forEach(s => {
                const key = `${s.fecha_entrega}_${s.empleado_id}`;
                if (!entregasMapa[key]) entregasMapa[key] = { fecha: s.fecha_entrega, empleado: s.empleados_fabriquines?.nombre || '?', sacos: [], kg: 0, lote_fecha: s.lotes_picadura?.fecha || '?' };
                entregasMapa[key].sacos.push(`#${s.numero_saco}(${s.peso_kg}kg)`);
                entregasMapa[key].kg += parseFloat(s.peso_kg);
            });
            const entregas = Object.values(entregasMapa).sort((a,b) => b.fecha > a.fecha ? 1:-1).slice(0,20);
        %>
        <% entregas.forEach(e => { %>
        <tr>
            <td><%= e.fecha %></td>
            <td style="font-weight:bold; text-transform:capitalize;"><%= e.empleado %></td>
            <td><small>Pesada <%= e.lote_fecha %></small></td>
            <td><%= e.sacos.join(', ') %></td>
            <td><strong><%= e.kg.toFixed(1) %> kg</strong></td>
        </tr>
        <% }); %>
    </table>
    <% } %>
</div>

<!-- MODAL DIVIDIR SACO -->
<div class="modal-overlay-pic" id="modal-division" onclick="if(event.target===this)this.classList.remove('activo')">
  <div class="modal-box-pic">
    <h3 style="margin:0 0 4px 0; color:var(--text-main);">✂️ Dividir Saco en Menores</h3>
    <p id="txt-saco-origen" style="font-size:13px; color:var(--text-muted); margin-bottom:16px;"></p>
    <p style="font-size:13px; margin-bottom:10px; font-weight:bold;">¿Cuántos sacos de cada tamaño crear?</p>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px;">
        <% [35,28,21,14,7].forEach(p => { %>
        <div style="display:flex; align-items:center; gap:10px; background:var(--bg-main); padding:9px; border-radius:8px;">
            <span class="saco-badge saco-<%= p %>"><%= p %> kg</span>
            <input type="number" id="div-qty-<%= p %>" min="0" value="0" 
                   style="width:60px; padding:5px; border:1px solid var(--border-color); border-radius:5px; text-align:center;"
                   oninput="recalcDivision()">
        </div>
        <% }); %>
    </div>
    <div id="div-preview" style="display:none; padding:10px; border-radius:8px; font-size:13px; margin-bottom:14px;"></div>
    <div style="display:flex; gap:10px;">
        <button onclick="confirmarDivision()" style="flex:1; background:var(--info); color:white; border:none; padding:11px; border-radius:8px; font-weight:bold; cursor:pointer;">✂️ Dividir</button>
        <button onclick="document.getElementById('modal-division').classList.remove('activo')" style="flex:1; background:var(--text-muted); color:white; border:none; padding:11px; border-radius:8px; cursor:pointer;">Cancelar</button>
    </div>
    <p id="div-error" style="color:var(--danger); font-size:13px; margin-top:8px; display:none;"></p>
  </div>
</div>

<script>
// ─── División de sacos ───
let sacoEnDivision = null; // { id, numero, peso_kg }

function abrirDivision(id, numero, pesoKg) {
    sacoEnDivision = { id, numero, peso_kg: parseFloat(pesoKg) };
    document.getElementById('txt-saco-origen').textContent = `Saco #${numero} — ${pesoKg} kg disponibles para redistribuir`;
    [35,28,21,14,7].forEach(p => { document.getElementById(`div-qty-${p}`).value = 0; });
    document.getElementById('div-preview').style.display = 'none';
    document.getElementById('div-error').style.display = 'none';
    document.getElementById('modal-division').classList.add('activo');
}

function recalcDivision() {
    if (!sacoEnDivision) return;
    const pesos = [35,28,21,14,7];
    let total = 0;
    pesos.forEach(p => { total += (parseInt(document.getElementById(`div-qty-${p}`).value) || 0) * p; });
    const sobrante = parseFloat((sacoEnDivision.peso_kg - total).toFixed(2));
    const prev = document.getElementById('div-preview');
    if (total > 0) {
        prev.style.display = 'block';
        prev.style.background = total > sacoEnDivision.peso_kg ? '#fef2f2' : 'var(--info-soft)';
        prev.innerHTML = `Total distribuido: <strong>${total} kg</strong> / ${sacoEnDivision.peso_kg} kg${sobrante > 0.1 ? ` — Sobrante: <strong>${sobrante} kg</strong> (se guarda)` : ''}${total > sacoEnDivision.peso_kg ? ' ⚠️ <span style="color:#dc2626">Excede el peso original</span>' : ''}`;
    } else {
        prev.style.display = 'none';
    }
}

async function confirmarDivision() {
    if (!sacoEnDivision) return;
    const pesos = [35,28,21,14,7];
    const distribuciones = [];
    pesos.forEach(p => {
        const qty = parseInt(document.getElementById(`div-qty-${p}`).value) || 0;
        if (qty > 0) distribuciones.push({ peso_kg: p, cantidad: qty });
    });
    if (distribuciones.length === 0) {
        document.getElementById('div-error').textContent = 'Ingresa al menos una cantidad.';
        document.getElementById('div-error').style.display = 'block';
        return;
    }
    const total = distribuciones.reduce((a, d) => a + d.peso_kg * d.cantidad, 0);
    if (total > sacoEnDivision.peso_kg + 0.01) {
        document.getElementById('div-error').textContent = `Total (${total}kg) excede el saco de ${sacoEnDivision.peso_kg}kg.`;
        document.getElementById('div-error').style.display = 'block';
        return;
    }
    document.getElementById('div-error').style.display = 'none';
    try {
        const resp = await fetch('/dividir_saco', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ saco_id: sacoEnDivision.id, distribuciones })
        });
        const data = await resp.json();
        if (data.ok) {
            document.getElementById('modal-division').classList.remove('activo');
            location.reload();
        } else {
            document.getElementById('div-error').textContent = data.msg || 'Error al dividir.';
            document.getElementById('div-error').style.display = 'block';
        }
    } catch(e) {
        document.getElementById('div-error').textContent = 'Error de conexión.';
        document.getElementById('div-error').style.display = 'block';
    }
}
</script>

<!-- (Eliminado: modal-entrega duplicaba los ids del bloque «Despacho de Material Activo» y nunca se abría.) -->

<script>
// Datos globales cargados desde el servidor (V2.9.7)
const facturasPendientes = <%- JSON.stringify((typeof facturasPend !== 'undefined' && facturasPend) ? facturasPend : []) %>;
let sacosSeleccionadosGlobal = []; // Array de { id, kg }

function toggleSaco(el) {
    const sacoId = el.getAttribute('data-saco-id');
    const kg     = parseFloat(el.getAttribute('data-kg'));
    
    const idx = sacosSeleccionadosGlobal.findIndex(x => x.id == sacoId);
    
    if (idx >= 0) {
        sacosSeleccionadosGlobal.splice(idx, 1);
        el.classList.remove('seleccionado');
    } else {
        sacosSeleccionadosGlobal.push({ id: sacoId, kg });
        el.classList.add('seleccionado');
    }
    const _btn = el.querySelector('.saco-sel');
    if (_btn) _btn.setAttribute('aria-pressed', String(idx < 0));
    
    actualizarPanelDespacho();
}

function actualizarPanelDespacho() {
    const totalKg = sacosSeleccionadosGlobal.reduce((acc, x) => acc + x.kg, 0);
    const count = sacosSeleccionadosGlobal.length;
    
    document.getElementById('resumen-sacos-sel').textContent = `${count} bultos = ${totalKg.toFixed(1)} kg seleccionados`;

    const empId = document.getElementById('sel-empleado-pic').value;
    if (empId && Array.isArray(facturasPendientes)) {
        const factura = facturasPendientes.find(f => f.empleado_id == empId);
        if (factura) recalcStatusPicadura(factura.picadura_kg);
    }
}

// Meta material data (Movido al inicio en V2.9.7)

// ─── Filtros de sacos disponibles: número, pesada y peso ───
(function () {
    const buscar = document.getElementById('sf-buscar');
    const selLote = document.getElementById('sf-lote');
    if (!buscar || !selLote) return;
    const chips = Array.from(document.querySelectorAll('.sf-chip'));
    const items = Array.from(document.querySelectorAll('.saco-item'));
    const resumen = document.getElementById('sf-resumen');
    const vacio = document.getElementById('sf-vacio');
    let peso = '';

    function aplicar() {
        const q = buscar.value.replace('#', '').trim();
        const lote = selLote.value;
        let visibles = 0;
        items.forEach(it => {
            const ok = (!q || it.dataset.num.includes(q))
                    && (!lote || it.dataset.lote === lote)
                    && (!peso || (peso === 'sob' ? it.dataset.tipo === 'sobrante'
                                                 : it.dataset.tipo !== 'sobrante' && parseFloat(it.dataset.kg) === parseFloat(peso)));
            it.hidden = !ok;
            if (ok) visibles++;
        });
        document.querySelectorAll('.saco-grupo').forEach(g => { g.hidden = !g.querySelector('.saco-item:not([hidden])'); });
        document.querySelectorAll('.lote-card.activo').forEach(l => { l.hidden = !l.querySelector('.saco-item:not([hidden])'); });
        const hayFiltro = !!(q || lote || peso);
        document.querySelectorAll('.lote-agotado').forEach(l => { l.hidden = hayFiltro; });
        resumen.textContent = 'Mostrando ' + visibles + ' de ' + items.length + ' sacos';
        vacio.hidden = visibles !== 0;
    }
    buscar.addEventListener('input', aplicar);
    selLote.addEventListener('change', aplicar);
    chips.forEach(c => c.addEventListener('click', () => {
        peso = c.dataset.peso;
        chips.forEach(x => x.setAttribute('aria-pressed', String(x === c)));
        aplicar();
    }));
    document.getElementById('sf-limpiar').addEventListener('click', () => {
        buscar.value = ''; selLote.value = ''; peso = '';
        chips.forEach(x => x.setAttribute('aria-pressed', String(x.dataset.peso === '')));
        aplicar(); buscar.focus();
    });
})();


function actualizarMetasMaterial() {
    const empId = document.getElementById('sel-empleado-pic').value;
    const bloque = document.getElementById('bloque-metas');
    const statusEl = document.getElementById('status-picadura');
    if (!Array.isArray(facturasPendientes)) return;
    const factura = facturasPendientes.find(f => f.empleado_id == empId);

    if (factura) {
        bloque.style.opacity = '1';
        bloque.style.pointerEvents = 'auto';
        document.getElementById('meta-pica').textContent = `${factura.picadura_kg} kg`;
        document.getElementById('meta-capa').textContent = `${factura.capa_kg} kg`;
        document.getElementById('meta-capo').textContent = `${factura.capote_kg} kg`;
        
        document.getElementById('real-capa-pic').value = factura.capa_kg;
        document.getElementById('real-capote-pic').value = factura.capote_kg;
        
        recalcStatusPicadura(factura.picadura_kg);
    } else {
        bloque.style.opacity = '0.5';
        bloque.style.pointerEvents = 'none';
        statusEl.innerHTML = `⚠️ Selecciona un trabajador primero.`;
        statusEl.style.background = 'transparent';
        statusEl.style.color = '#6b7280';
    }
}

function recalcStatusPicadura(meta) {
    const actual = sacosSeleccionadosGlobal.reduce((acc, x) => acc + x.kg, 0);
    const statusEl = document.getElementById('status-picadura');
    const diff = actual - meta;

    if (actual === 0) {
        statusEl.innerHTML = `⚠️ Falta seleccionar los sacos p/ ${meta} kg`;
        statusEl.style.background = 'transparent';
        statusEl.style.color = '#dc2626';
    } else if (Math.abs(diff) < 0.1) {
        statusEl.innerHTML = `✅ ¡Perfecto! Meta de ${meta} kg cubierta.`;
        statusEl.style.background = 'transparent';
        statusEl.style.color = '#10b981';
    } else if (diff > 0) {
        statusEl.innerHTML = `⚠️ Exceso de ${diff.toFixed(1)} kg.`;
        statusEl.style.background = 'transparent';
        statusEl.style.color = '#dc2626';
    } else {
        statusEl.innerHTML = `⏳ Faltan ${Math.abs(diff).toFixed(1)} kg p/ la meta.`;
        statusEl.style.background = 'transparent';
        statusEl.style.color = '#3b82f6';
    }
}

async function confirmarEntrega() {
    const empleado_id = document.getElementById('sel-empleado-pic').value;
    const capa_real_kg   = document.getElementById('real-capa-pic').value;
    const capote_real_kg = document.getElementById('real-capote-pic').value;
    const errEl       = document.getElementById('pic-error');
    
    if (!empleado_id) { errEl.textContent = 'Selecciona un fabriquín.'; errEl.style.display = 'block'; return; }
    
    const btn = document.querySelector('button[onclick="confirmarEntrega()"]');
    const oldText = btn.innerHTML;
    const sacos_ids = sacosSeleccionadosGlobal.map(x => x.id);

    if (sacos_ids.length === 0) { errEl.textContent = 'Sin sacos seleccionados.'; errEl.style.display = 'block'; return; }
    
    errEl.style.display = 'none';
    btn.innerHTML = '⏳ DESPACHANDO...';
    btn.disabled = true;

    try {
        const resp = await fetch('/entregar_sacos', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sacos_ids, empleado_id, capa_real_kg, capote_real_kg })
        });
        const data = await resp.json();
        if (data.ok) {
            btn.innerHTML = '✅ DESPACHO FINALIZADO';
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: '¡Despacho Exitoso!',
                    text: 'La saca y los pesos fueron asignados correctamente al fabriquín.',
                    icon: 'success',
                    confirmButtonColor: '#10b981'
                }).then(() => location.reload());
            } else {
                setTimeout(() => { location.reload(); }, 1000);
            }
        } else {
            errEl.textContent = data.msg || 'Error al procesar.';
            errEl.style.display = 'block';
            btn.innerHTML = oldText;
            btn.disabled = false;
        }
    } catch(e) {
        errEl.textContent = 'Fallo de conexión. Por favor reintenta.';
        errEl.style.display = 'block';
        btn.innerHTML = oldText;
        btn.disabled = false;
    }
}

// ─── Cálculo en vivo del formulario de nuevo lote ───
(function() {
    const pesos  = [35, 28, 21, 14, 7];
    const inputs = pesos.map(p => document.querySelector(`[name="sacos_${p}"]`));
    const inpSobQty = document.querySelector('[name="sacos_sobrante_qty"]');
    const inpSobKg  = document.querySelector('[name="sacos_sobrante_kg"]');
    const inpEntrada= document.querySelector('[name="kg_entrada"]');
    const resumen   = document.getElementById('resumen-calculo');
    const txtSalida = document.getElementById('txt-kg-salida');
    const txtDif    = document.getElementById('txt-diferencia');
    
    function recalc() {
        let salida = 0;
        pesos.forEach((p, i) => { salida += (parseInt(inputs[i].value) || 0) * p; });
        salida += (parseFloat(inpSobKg.value) || 0);
        
        const entrada = parseFloat(inpEntrada.value) || 0;
        const dif = salida - entrada;
        
        if (salida > 0) {
            resumen.style.display = 'block';
            txtSalida.textContent = salida.toFixed(1);
            txtDif.textContent = (dif >= 0 ? '+' : '') + dif.toFixed(1) + ' kg';
            txtDif.style.color = dif >= 0 ? '#16a34a' : '#dc2626';
        } else {
            resumen.style.display = 'none';
        }
    }
    
    inputs.forEach(i => i.addEventListener('input', recalc));
    inpSobQty.addEventListener('input', recalc);
    inpSobKg.addEventListener('input', recalc);
    inpEntrada.addEventListener('input', recalc);
})();
</script>

