<%- include('../partials/header') %>

<style>
    .btn-guardar   { background: #3b82f6; color: white; padding: 8px 14px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
    .btn-liquidar  { background: #10b981; color: white; padding: 8px 14px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 13px; }
    .btn-prestamo  { background: #f59e0b; color: white; padding: 6px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px; }
    .btn-extra     { background: #15803d; color: white; padding: 6px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px; }
    .btn-historial { background: #6b7280; color: white; padding: 6px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 12px; }
    .badge-pendiente { font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 10px; display: inline-block; }
    .badge-pendiente.rojo  { background: #fee2e2; color: #b91c1c; }
    .badge-pendiente.verde { background: #dcfce7; color: #15803d; }
    .inp-dia { width: 100%; padding: 5px; text-align: center; border: 1px solid var(--border-color); border-radius: 4px; background: transparent; color: var(--text-main); font-size: 13px; box-sizing: border-box; }
    .inp-dia:focus { outline: 2px solid #3b82f6; }

    /* Toast */
    #toast-exito { position: fixed; top: 20px; right: 20px; background: #065f46; color: white; padding: 16px 22px; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); z-index: 9999; display: none; max-width: 380px; font-size: 14px; }
    #toast-exito a { color: #6ee7b7; font-weight: bold; text-decoration: underline; }

    /* Modales */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 8000; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
    .modal-overlay.activo { display: flex; }
    .modal-box { background: var(--bg-card); border-radius: 16px; padding: 30px; width: 450px; max-width: 95vw; border: 1px solid var(--border-color); }
    html.dark-mode .modal-box { background: #1f2937; color: #e5e7eb; border-color: #374151; }
    html.dark-mode .modal-box input, html.dark-mode .modal-box select { background: #111827; color: #e5e7eb; border-color: #4b5563; }

    /* Historial */
    .historial-box { display: none; border-top: 1px solid var(--border-color); padding: 12px 16px; background: rgba(0,0,0,0.03); }
    .historial-box.visible { display: block; }
    .historial-tabla { width: 100%; font-size: 12px; border-collapse: collapse; }
    .historial-tabla td, .historial-tabla th { padding: 4px 8px; border: 1px solid var(--border-color); }
    .historial-tabla th { background: var(--bg-card); }
</style>

<!-- TOAST -->
<div id="toast-exito">
    <div style="font-size:18px; margin-bottom:6px;">✅ <strong id="toast-msg">Tarea asignada</strong></div>
    <div id="toast-link-container" style="margin-top: 8px;"></div>
    <button onclick="document.getElementById('toast-exito').style.display='none'" style="margin-top:10px; background:rgba(255,255,255,0.2); border:none; color:white; padding:4px 10px; border-radius:4px; cursor:pointer; font-size:12px;">✕ Cerrar</button>
</div>

<!-- MODAL PRÉSTAMO -->
<div class="modal-overlay" id="modal-prestamo">
    <div class="modal-box">
        <h3 style="margin:0 0 16px 0; color:#92400e;">💳 Registrar Movimiento de Préstamo</h3>
        <p id="modal-emp-nombre" style="font-weight:bold; margin-bottom:12px;"></p>
        <label style="font-size:13px; font-weight:bold;">Tipo de Movimiento:</label>
        <select id="modal-tipo" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px;">
            <option value="prestamo">💵 Préstamo / Adelanto en efectivo</option>
            <option value="descuento_sueldo">✂️ Descuento directo de sueldo</option>
            <option value="abono">💚 Abono (pago parcial de deuda)</option>
        </select>
        <label style="font-size:13px; font-weight:bold;">Monto ($):</label>
        <input type="number" id="modal-monto" placeholder="Ej: 50000" min="0" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <label style="font-size:13px; font-weight:bold;">Fecha:</label>
        <input type="date" id="modal-fecha" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <label style="font-size:13px; font-weight:bold;">Nota (opcional):</label>
        <input type="text" id="modal-nota" placeholder="Ej: Para pagar operarios internos" style="width:100%; padding:8px; margin-bottom:18px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <div style="display:flex; gap:10px;">
            <button onclick="guardarMovimientoPrestamo()" style="flex:1; background:#f59e0b; color:white; border:none; padding:10px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:14px;">💾 Guardar</button>
            <button onclick="cerrarModal()" style="flex:1; background:#6b7280; color:white; border:none; padding:10px; border-radius:6px; cursor:pointer; font-size:14px;">Cancelar</button>
        </div>
        <p id="modal-error" style="color:#ef4444; font-size:12px; margin-top:8px; display:none;"></p>
    </div>
</div>

<!-- MODAL MATERIAL EXTRA -->
<div class="modal-overlay" id="modal-extra">
    <div class="modal-box">
        <h3 style="margin:0 0 16px 0; color:#15803d;">🌿 Material Extra Entre Semana</h3>
        <p id="modal-extra-emp" style="font-weight:bold; margin-bottom:12px;"></p>
        <p style="font-size:12px; color:#6b7280; margin-bottom:12px;">El material extra queda como deuda. Gregorío puede descontarlo en los siguientes despachos.</p>
        <label style="font-size:13px; font-weight:bold;">Material:</label>
        <select id="extra-material" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px;">
            <option value="capa">🍃 Capa</option>
            <option value="capote">🌿 Capote</option>
            <option value="picadura">🪴 Picadura</option>
        </select>
        <label style="font-size:13px; font-weight:bold;">Cantidad (kg):</label>
        <input type="number" id="extra-kg" placeholder="Ej: 2" min="0.01" step="0.01" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <label style="font-size:13px; font-weight:bold;">Fecha:</label>
        <input type="date" id="extra-fecha" style="width:100%; padding:8px; margin-bottom:12px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <label style="font-size:13px; font-weight:bold;">Motivo (opcional):</label>
        <input type="text" id="extra-nota" placeholder="Ej: Capa salió mala, necesitó reemplazo" style="width:100%; padding:8px; margin-bottom:18px; border:1px solid var(--border-color); border-radius:6px; font-size:14px; box-sizing:border-box;">
        <div style="display:flex; gap:10px;">
            <button onclick="guardarMaterialExtra()" style="flex:1; background:#15803d; color:white; border:none; padding:10px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:14px;">💾 Guardar</button>
            <button onclick="cerrarModalExtra()" style="flex:1; background:#6b7280; color:white; border:none; padding:10px; border-radius:6px; cursor:pointer; font-size:14px;">Cancelar</button>
        </div>
        <p id="extra-error" style="color:#ef4444; font-size:12px; margin-top:8px; display:none;"></p>
    </div>
</div>

<!-- ENCABEZADO -->
<div style="margin-bottom: 20px;">
    <h1 style="margin: 0; color: var(--text-main);">📅 Recepción Diaria de Fabriquines</h1>
    <p style="color: var(--text-muted); margin-top: 5px;">Guarda los avances diarios de Lunes a Sábado. Al liquidar se generará la nómina de la semana.</p>
</div>

<!-- BARRA DE BÚSQUEDA -->
<div style="margin-bottom: 20px;">
    <input type="text" id="buscar-fabr" placeholder="🔍 Buscar fabriquín por nombre o código..."
           oninput="filtrarTarjetas('buscar-fabr', '.tarjeta-fabr')"
           style="width: 100%; max-width: 460px; padding: 10px 16px; border: 2px solid var(--border-color); border-radius: 10px; font-size: 14px; background: var(--bg-card); color: var(--text-main); box-sizing: border-box;">
    <span id="contador-fabr" style="margin-left: 12px; font-size: 13px; color: var(--text-muted);"></span>
</div>

<% empleados.forEach(emp => {
    let reg = registros.find(r => r.empleado_id === emp.id) || {};
    const prestamo = (prestamos || []).find(p => p.empleado_id === emp.id);
    const histEmp  = (historialPrestamos || {})[emp.id] || [];
    const totalRecibido = (reg.lun_tabacos||0)+(reg.mar_tabacos||0)+(reg.mie_tabacos||0)+(reg.jue_tabacos||0)+(reg.vie_tabacos||0)+(reg.sab_tabacos||0);
    const pendiente = emp.deuda_tabacos - totalRecibido;
    const saldoPrestamo = prestamo ? parseInt(prestamo.saldo_pendiente) : 0;
%>

<div class="card tarjeta-fabr" id="card-<%= emp.id %>" data-nombre="<%= (emp.codigo + ' ' + emp.nombre).toLowerCase() %>" style="margin-bottom: 20px; padding: 0; overflow: hidden; border-left: 5px solid <%= pendiente <= 0 ? '#10b981' : '#f59e0b' %>;">

    <!-- CABECERA -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--bg-card); border-bottom: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px;">
        <div>
            <strong style="font-size: 15px; color: var(--text-main);"><%= emp.codigo %> — <%= emp.nombre %></strong>
            <br>
            <span class="badge-pendiente <%= pendiente <= 0 ? 'verde' : 'rojo' %>" id="badge-<%= emp.id %>" data-deuda="<%= emp.deuda_tabacos %>" style="margin-top: 4px;">
                <%= pendiente <= 0 ? '✅ Tarea Completa' : '⏳ Pendiente: ' + pendiente.toLocaleString('es-CO') + ' tabs' %>
            </span>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
            <% if (saldoPrestamo > 0) { %>
            <span style="font-size: 12px; color: #92400e; font-weight: bold; background: #fef3c7; padding: 4px 10px; border-radius: 6px;">
                💳 Préstamo: $<%= saldoPrestamo.toLocaleString('es-CO') %>
            </span>
            <% } %>
            <button class="btn-extra"     onclick="abrirModalExtra('<%= emp.id %>', '<%= emp.nombre %>')">🌿 Extra</button>
            <button class="btn-prestamo"  onclick="abrirModalPrestamo('<%= emp.id %>', '<%= emp.nombre %>', '<%= saldoPrestamo %>')">💳 Préstamo</button>
            <% if (histEmp.length > 0) { %>
            <button class="btn-historial" onclick="toggleHistorial('<%= emp.id %>')">📋 Historial</button>
            <% } %>
            <% if (despachoId == emp.id) { %>
            <a href="/imprimir_despacho/<%= emp.id %>" target="_blank"
               style="background:#7c3aed; color:white; padding:6px 12px; border-radius:6px; font-size:12px; text-decoration:none; font-weight:bold;">🖨️ Imprimir</a>
            <% } %>
        </div>
    </div>

    <!-- FORMULARIO DIARIO -->
    <form action="/recepcion_diaria_guardar" method="POST" style="padding: 16px;">
        <input type="hidden" name="empleado_id"  value="<%= emp.id %>">
        <input type="hidden" name="registro_id"  value="<%= reg.id || '' %>">

        <div style="display: grid; grid-template-columns: repeat(6, 1fr) 200px; gap: 12px; align-items: start;">

            <% const dias = [
                { label: 'Lunes',     cestasKey: 'lun_cestas',  tabKey: 'lun_tabacos'  },
                { label: 'Martes',    cestasKey: 'mar_cestas',  tabKey: 'mar_tabacos'  },
                { label: 'Miércoles', cestasKey: 'mie_cestas',  tabKey: 'mie_tabacos'  },
                { label: 'Jueves',    cestasKey: 'jue_cestas',  tabKey: 'jue_tabacos'  },
                { label: 'Viernes',   cestasKey: 'vie_cestas',  tabKey: 'vie_tabacos'  },
                { label: 'Sábado',    cestasKey: 'sab_cestas',  tabKey: 'sab_tabacos'  }
            ]; %>

            <% dias.forEach(d => { %>
            <div>
                <div style="font-size: 11px; font-weight: bold; color: var(--text-muted); margin-bottom: 6px; text-align: center;"><%= d.label %></div>
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div>
                        <div style="font-size: 9px; color: var(--text-muted); text-align: center; margin-bottom: 2px;">Cestas</div>
                        <input type="number" name="<%= d.cestasKey %>"
                               class="inp-dia inp-cestas"
                               data-emp="<%= emp.id %>"
                               value="<%= reg[d.cestasKey] || '' %>"
                               min="0" placeholder="0">
                    </div>
                    <div>
                        <div style="font-size: 9px; color: var(--text-muted); text-align: center; margin-bottom: 2px;">Tabacos</div>
                        <input type="number" name="<%= d.tabKey %>"
                               class="inp-dia inp-tabacos"
                               data-emp="<%= emp.id %>"
                               value="<%= reg[d.tabKey] || '' %>"
                               placeholder="0">
                    </div>
                </div>
            </div>
            <% }); %>

            <!-- COLUMNA EXTRA: SUBPRODUCTOS + PRÉSTAMO + BOTONES -->
            <div>
                <div style="font-size: 11px; font-weight: bold; color: #b45309; margin-bottom: 4px;">🍂 Recorte (kg)</div>
                <input type="number" name="recorte_kg" step="0.01" min="0"
                       value="<%= reg.recorte_kg || '' %>"
                       class="inp-dia"
                       style="border-color: #fde68a; background: #fef9c3;" placeholder="0.00">

                <div style="font-size: 11px; font-weight: bold; color: #1d4ed8; margin-top: 6px; margin-bottom: 4px;">🌿 Vena (kg)</div>
                <input type="number" name="vena_kg" step="0.01" min="0"
                       value="<%= reg.vena_kg || '' %>"
                       class="inp-dia"
                       style="border-color: #bfdbfe; background: #eff6ff;" placeholder="0.00">

                <div style="font-size: 11px; font-weight: bold; color: #059669; margin-top: 6px; margin-bottom: 4px;">✨ Extras (tabs)</div>
                <input type="number" name="extra_tabacos"
                       value="<%= reg.extra_tabacos || '' %>"
                       class="inp-dia"
                       style="border-color: #a7f3d0; background: #ecfdf5;" placeholder="0">

                <% if (prestamo) { %>
                <div style="font-size: 11px; font-weight: bold; color: #92400e; margin-top: 6px; margin-bottom: 4px;">💳 Abono a Préstamo ($)</div>
                <input type="number" name="abono_prestamo" placeholder="Monto abono"
                       min="0" max="<%= prestamo.saldo_pendiente %>"
                       class="inp-dia"
                       style="border-color: #fcd34d; background: #fffbeb;">
                <input type="hidden" name="prestamo_id" value="<%= prestamo.id %>">
                <% } %>

                <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 6px;">
                    <button type="submit" class="btn-guardar" style="width:100%;">💾 Guardar</button>
                    <% if (reg.id) { %>
                    <button type="button" class="btn-liquidar" style="width:100%;"
                            onclick="liquidarSemana('<%= reg.id %>')">💰 Liquidar</button>
                    <% } %>
                </div>
            </div>

        </div>
    </form>

    <!-- HISTORIAL EXPANDIBLE -->
    <% if (histEmp.length > 0) { %>
    <div class="historial-box" id="hist-<%= emp.id %>">
        <strong style="font-size:13px; color: var(--text-main);">📋 Historial de Préstamos — <%= emp.nombre %></strong>
        <table class="historial-tabla" style="margin-top: 8px;">
            <thead><tr><th>Fecha</th><th>Tipo</th><th>Monto</th><th>Nota</th></tr></thead>
            <tbody>
                <% histEmp.forEach(h => {
                    const esCargo = h.monto_abono < 0;
                    const tipoLabel = esCargo ? (h.tipo === 'prestamo' ? '💵 Préstamo' : h.tipo === 'descuento_sueldo' ? '✂️ Desc. Sueldo' : '📦 Cargo') : '💚 Abono';
                %>
                <tr style="<%= esCargo ? 'color:#b91c1c;' : 'color:#059669;' %>">
                    <td><%= h.fecha %></td>
                    <td><%= tipoLabel %></td>
                    <td>$<%= Math.abs(h.monto_abono).toLocaleString('es-CO') %></td>
                    <td style="color: var(--text-muted);"><%= h.nota || '—' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>

</div>

<% }); %>

<script>
    // ── Auto-calcular tabacos al escribir cestas (×1250) ──
    document.querySelectorAll('.inp-cestas').forEach(inp => {
        inp.addEventListener('input', function() {
            const val   = parseFloat(this.value) || 0;
            const form  = this.closest('form');
            // Encontrar el input de tabacos hermano
            const wrapper = this.closest('div').parentElement;
            const tabInput = wrapper.querySelector('.inp-tabacos');
            if (tabInput) tabInput.value = val > 0 ? val * 1250 : '';
            // Actualizar badge de deuda
            recalcularDeuda(this.getAttribute('data-emp'));
        });
    });

    document.querySelectorAll('.inp-tabacos').forEach(inp => {
        inp.addEventListener('input', function() {
            recalcularDeuda(this.getAttribute('data-emp'));
        });
    });

    function recalcularDeuda(empId) {
        const badge = document.getElementById('badge-' + empId);
        if (!badge) return;
        const deuda = parseInt(badge.getAttribute('data-deuda')) || 0;
        let total = 0;
        document.querySelectorAll(`.inp-tabacos[data-emp="${empId}"]`).forEach(i => total += parseInt(i.value) || 0);
        const pendiente = deuda - total;
        if (pendiente <= 0) {
            badge.textContent = '✅ Tarea Completa';
            badge.className   = 'badge-pendiente verde';
        } else {
            badge.textContent = '⏳ Pendiente: ' + pendiente.toLocaleString('es-CO') + ' tabs';
            badge.className   = 'badge-pendiente rojo';
        }
    }

    // ── Liquidar ──
    function liquidarSemana(registroId) {
        if (confirm("¿Liquidar la semana de este Fabriquín? Se cerrará la hoja, actualizará la deuda y generará la Nómina.")) {
            const form = document.createElement("form");
            form.method = "POST";
            form.action = "/liquidar_semana/" + registroId;
            form.target = "_blank";
            document.body.appendChild(form);
            form.submit();
            setTimeout(() => window.location.href = '/nomina', 2500);
        }
    }

    // ── Historial ──
    function toggleHistorial(empId) {
        const box = document.getElementById('hist-' + empId);
        if (box) box.classList.toggle('visible');
    }

    // ── Modal Préstamo ──
    let modalEmpId = null;
    function abrirModalPrestamo(empId, nombre, saldoActual) {
        modalEmpId = empId;
        document.getElementById('modal-emp-nombre').textContent = nombre + (saldoActual > 0 ? ' — Deuda: $' + parseInt(saldoActual).toLocaleString('es-CO') : '');
        document.getElementById('modal-monto').value = '';
        document.getElementById('modal-nota').value  = '';
        document.getElementById('modal-error').style.display = 'none';
        document.getElementById('modal-fecha').value = new Date().toISOString().slice(0,10);
        document.getElementById('modal-prestamo').classList.add('activo');
    }
    function cerrarModal() {
        document.getElementById('modal-prestamo').classList.remove('activo');
        modalEmpId = null;
    }
    async function guardarMovimientoPrestamo() {
        const tipo  = document.getElementById('modal-tipo').value;
        const monto = document.getElementById('modal-monto').value;
        const fecha = document.getElementById('modal-fecha').value;
        const nota  = document.getElementById('modal-nota').value;
        const errEl = document.getElementById('modal-error');
        if (!monto || parseInt(monto) <= 0) { errEl.textContent = 'Ingresa un monto mayor a 0.'; errEl.style.display = 'block'; return; }
        errEl.style.display = 'none';
        try {
            const resp = await fetch('/registrar_movimiento_prestamo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ empleado_id: modalEmpId, tipo, monto, fecha, nota }) });
            const data = await resp.json();
            if (data.ok) { cerrarModal(); setTimeout(() => location.reload(), 600); }
            else { errEl.textContent = data.msg || 'Error al guardar.'; errEl.style.display = 'block'; }
        } catch(e) { errEl.textContent = 'Error de conexión.'; errEl.style.display = 'block'; }
    }
    document.getElementById('modal-prestamo').addEventListener('click', function(e) { if (e.target === this) cerrarModal(); });

    // ── Modal Material Extra ──
    let extraEmpId = null;
    function abrirModalExtra(empId, nombre) {
        extraEmpId = empId;
        document.getElementById('modal-extra-emp').textContent = nombre;
        document.getElementById('extra-kg').value   = '';
        document.getElementById('extra-nota').value = '';
        document.getElementById('extra-error').style.display = 'none';
        document.getElementById('extra-fecha').value = new Date().toISOString().slice(0,10);
        document.getElementById('modal-extra').classList.add('activo');
    }
    function cerrarModalExtra() {
        document.getElementById('modal-extra').classList.remove('activo');
        extraEmpId = null;
    }
    async function guardarMaterialExtra() {
        const material = document.getElementById('extra-material').value;
        const kg       = parseFloat(document.getElementById('extra-kg').value);
        const fecha    = document.getElementById('extra-fecha').value;
        const nota     = document.getElementById('extra-nota').value;
        const errEl    = document.getElementById('extra-error');
        if (!kg || kg <= 0) { errEl.textContent = 'Ingresa una cantidad mayor a 0.'; errEl.style.display = 'block'; return; }
        errEl.style.display = 'none';
        try {
            const resp = await fetch('/registrar_material_extra', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ empleado_id: extraEmpId, material, kg, fecha, nota }) });
            const data = await resp.json();
            if (data.ok) { cerrarModalExtra(); alert(`✅ ${data.msg}`); }
            else { errEl.textContent = data.msg || 'Error al guardar.'; errEl.style.display = 'block'; }
        } catch(e) { errEl.textContent = 'Error de conexión.'; errEl.style.display = 'block'; }
    }
    document.getElementById('modal-extra').addEventListener('click', function(e) { if (e.target === this) cerrarModalExtra(); });

    // ── Toast post-despacho ──
    (function() {
        const params = new URLSearchParams(window.location.search);
        const ok = params.get('ok'), despId = params.get('despacho_id');
        if (!ok) return;
        const toast = document.getElementById('toast-exito');
        document.getElementById('toast-msg').textContent = decodeURIComponent(ok.replace(/\+/g,' '));
        if (despId) document.getElementById('toast-link-container').innerHTML = `<a href="/imprimir_despacho/${despId}" target="_blank">🖨️ Imprimir Orden de Despacho</a>`;
        toast.style.display = 'block';
        setTimeout(() => toast.style.display = 'none', 12000);
        history.replaceState({}, '', '/recepcion_diaria');
    })();
    // ── Filtro de búsqueda en tiempo real ──
    function filtrarTarjetas(inputId, selector) {
        const q = document.getElementById(inputId).value.toLowerCase().trim();
        const tarjetas = document.querySelectorAll(selector);
        let visibles = 0;
        tarjetas.forEach(card => {
            const nombre = card.getAttribute('data-nombre') || '';
            const mostrar = !q || nombre.includes(q);
            card.style.display = mostrar ? '' : 'none';
            if (mostrar) visibles++;
        });
        // Actualizar contador
        const counterId = inputId.replace('buscar-', 'contador-');
        const counter = document.getElementById(counterId);
        if (counter) counter.textContent = q ? `${visibles} resultado(s)` : '';
    }
</script>

