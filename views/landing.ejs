<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Don Gato | Software de Gestión Tabaquera</title>
    <!-- Incluimos Tailwind CSS por CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { theme: { extend: {
            fontFamily: { sans: ['Inter','sans-serif'], display: ['Outfit','Inter','sans-serif'] },
            colors: {
                orange: { 400:'#D9743A', 500:'#B4541A', 600:'#9A4515' },
                slate: { 200:'#E8DCC6', 300:'#D3C4A9', 400:'#B3A28A', 500:'#8F7E68', 600:'#6E5F4C', 700:'#3D3022', 800:'#271E15', 900:'#1B1510', 950:'#120E0A' }
            } } } };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/img/logo.png">
    <link rel="stylesheet" href="/css/cat-loader.css">
    <link rel="stylesheet" href="/css/landing-fx.css">
    <script>
        /* Elige modo WebGL o ligero antes del primer pintado (?lite=1 / ?fx=1 fuerzan cada modo) */
        (function () {
            var d = document.documentElement, q = location.search, m = function (s) { return matchMedia(s).matches; };
            d.classList.add('js', 'is-loading');
            var reduced = m('(prefers-reduced-motion: reduce)');
            var lite = m('(max-width: 768px)') || m('(pointer: coarse)') || reduced
                || (navigator.deviceMemory && navigator.deviceMemory <= 2)
                || (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2)
                || (navigator.connection && navigator.connection.saveData);
            if (/[?&]lite=1/.test(q)) lite = true;
            if (/[?&]fx=1/.test(q)) lite = false;
            if (!lite) {
                try { var c = document.createElement('canvas'); if (!(c.getContext('webgl2') || c.getContext('webgl'))) lite = true; }
                catch (e) { lite = true; }
            }
            d.classList.add(lite ? 'fx-lite' : 'fx-gl');
            if (reduced) d.classList.add('fx-reduced');
        })();
    </script>
    <noscript><style>#loader { display: none !important; }</style></noscript>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1B1510; /* Fondo oscuro Gato Negro */
            color: #f8fafc;
            overflow-x: hidden;
            cursor: default;
        }

        /* Ocultar scrollbar para estética */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1B1510; 
        }
        ::-webkit-scrollbar-thumb {
            background: #3D3022; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #6E5F4C; 
        }

        /* Filtro para Neko98: El gato por defecto es blanco, esto lo vuelve negro */
        #oneko {
            filter: invert(1) hue-rotate(180deg);
        }

        /* Gradiente de fondo similar al de la imagen */
        .bg-gradient-dark {
            background-image: radial-gradient(circle at 20% 0%, rgba(180,84,26,0.18), transparent 45%);
            background: radial-gradient(circle at center, #271E15 0%, #1B1510 100%);
        }
    </style>
</head>
<body class="antialiased bg-gradient-dark">

