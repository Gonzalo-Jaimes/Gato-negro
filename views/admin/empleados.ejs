<%- include('../partials/header') %>

<style>
    .emp-form { display: grid; grid-template-columns: minmax(120px, 160px) 1fr 1fr auto; gap: var(--space-4); align-items: start; }
    .emp-form .field { margin-bottom: 0; }
    .emp-form .emp-enviar { align-self: start; margin-top: calc(var(--text-sm) * 1.5 + var(--space-1) + 6px); }
    .emp-alerta { grid-column: 1 / -1; padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--danger-soft); border: 1px solid var(--danger); }
    .emp-alerta[hidden] { display: none; }
    .emp-cab { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; margin: var(--space-8) 0 var(--space-3); }
    @media (max-width: 900px) { .emp-form { grid-template-columns: 1fr 1fr; } .emp-form .emp-enviar { grid-column: 1 / -1; margin-top: 0; } }
    @media (max-width: 560px) { .emp-form { grid-template-columns: 1fr; } }
</style>

<h1>👨‍🏭 Gestión de Empleados Fabriquines</h1>
<p style="color: var(--text-muted); margin-bottom: var(--space-6);">Registra o elimina administrativamente a los trabajadores (código F01, AN12…). Los cambios se aplican al instante.</p>

<h2 id="h-nuevo">Registrar nuevo empleado</h2>
<form id="form-empleado" class="card emp-form" action="/agregar_empleado" method="POST" aria-labelledby="h-nuevo" novalidate style="margin-top: var(--space-3);">
    <div class="emp-alerta field-error" data-form-alerta role="alert" hidden></div>
    <div class="field">
        <label for="emp-codigo">Código</label>
        <input type="text" id="emp-codigo" name="codigo" class="input" placeholder="F01" autocomplete="off" required maxlength="7" style="text-transform: uppercase;">
        <span class="field-hint" id="emp-codigo-ayuda">Letras y números.</span>
    </div>
    <div class="field">
        <label for="emp-nombre">Nombre completo</label>
        <input type="text" id="emp-nombre" name="nombre" class="input" placeholder="Nombre y apellido" autocomplete="off" required maxlength="80">
        <span class="field-hint" id="emp-nombre-ayuda">Como aparece en su documento.</span>
    </div>
    <div class="field">
        <label for="emp-cedula">Documento</label>
        <input type="text" id="emp-cedula" name="cedula" class="input" placeholder="CC-88193514" autocomplete="off" required maxlength="20" inputmode="text">
        <span class="field-hint" id="emp-cedula-ayuda">Prefijo (CC-, V-) y 5 a 12 números.</span>
    </div>
    <button type="submit" class="btn btn-success emp-enviar">✚ Habilitar trabajador</button>
</form>

<div class="emp-cab">
    <h2 id="h-lista">Lista histórica de trabajadores</h2>
    <button type="button" class="btn btn-ghost btn-sm" id="emp-actualizar">↻ Actualizar lista</button>
</div>

<table id="tabla-empleados" class="table-cards" aria-labelledby="h-lista">
    <thead>
        <tr>
            <th scope="col" data-sort="texto" data-col="esencial">Código</th>
            <th scope="col" data-sort="texto" data-col="esencial">Nombre del trabajador</th>
            <th scope="col" data-sort="texto" data-col="secundaria">Documento</th>
            <th scope="col" data-col="esencial"><span class="sr-only">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
        <% empleados.forEach(function(e) { %>
        <tr data-id="<%= e.id %>">
            <td data-label="Código"><strong><%= e.codigo %></strong></td>
            <td data-label="Nombre"><%= e.nombre %></td>
            <td data-label="Documento"><%= e.cedula %></td>
            <td class="acciones">
                <form action="/eliminar_empleado/<%= e.id %>" method="POST" class="form-eliminar" style="margin: 0;"
                      data-confirm="Se borrará el registro de <%= e.nombre %> y su información de deuda. Esta acción no se puede deshacer."
                      data-confirm-titulo="¿Eliminar a <%= e.nombre %>?" data-confirm-ok="Sí, eliminar" data-confirm-tipo="peligro">
                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Eliminar a <%= e.nombre %>">🗑 Eliminar</button>
                </form>
            </td>
        </tr>
        <% }); %>
    </tbody>
</table>

<script>
/* ui.js se carga con defer: se espera a DOMContentLoaded para usar UI */
document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('form-empleado');
    const tablaEl = document.getElementById('tabla-empleados');
    const btnActualizar = document.getElementById('emp-actualizar');

    /* --- Tabla: búsqueda, orden, paginación y estados (vacío, sin resultados) --- */
    const tabla = UI.tabla(tablaEl, {
        etiquetaBusqueda: 'Buscar trabajador por código, nombre o documento',
        placeholder: 'Buscar trabajador…',
        vacio: {
            titulo: 'Aún no hay trabajadores registrados',
            texto: 'Registra al primero con el formulario de arriba para poder asignarle tareas.',
            acciones: [{ texto: 'Registrar el primero', clase: 'btn-primary', onClick: () => document.getElementById('emp-codigo').focus() }]
        }
    });

    /* --- Filas creadas desde datos (alta y recarga) --- */
    function crearFila(e) {
        const tr = document.createElement('tr');
        tr.dataset.id = e.id;
        const celdas = [['Código', '<strong></strong>', e.codigo], ['Nombre', null, e.nombre], ['Documento', null, e.cedula]];
        celdas.forEach(([label, html, texto]) => {
            const td = document.createElement('td');
            td.dataset.label = label;
            if (html) { td.innerHTML = html; td.firstChild.textContent = texto; } else td.textContent = texto;
            tr.appendChild(td);
        });
        const acc = document.createElement('td');
        acc.className = 'acciones';
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/eliminar_empleado/' + e.id; f.className = 'form-eliminar'; f.style.margin = '0';
        f.dataset.confirm = 'Se borrará el registro de ' + e.nombre + ' y su información de deuda. Esta acción no se puede deshacer.';
        f.dataset.confirmTitulo = '¿Eliminar a ' + e.nombre + '?';
        f.dataset.confirmOk = 'Sí, eliminar';
        f.dataset.confirmTipo = 'peligro';
        const b = document.createElement('button');
        b.type = 'submit'; b.className = 'btn btn-danger btn-sm'; b.textContent = '🗑 Eliminar';
        b.setAttribute('aria-label', 'Eliminar a ' + e.nombre);
        f.appendChild(b); acc.appendChild(f); tr.appendChild(acc);
        return tr;
    }

    /* --- Formulario: validación por campo (mismas reglas que el servidor) y envío asíncrono --- */
    UI.form(form, {
        campos: {
            codigo: (v) => !v ? 'Escribe el código del trabajador (ejemplo: F01).'
                : !/^[A-Za-z]{1,3}\d{1,4}$/.test(v) ? 'El código lleva letras y luego números, sin espacios (ejemplo: F01 o AN12).' : null,
            nombre: (v) => !v ? 'Escribe el nombre completo del trabajador.'
                : v.length < 3 ? 'El nombre es muy corto: escribe al menos 3 letras.'
                : !/^[\p{L}][\p{L}\s.'-]*$/u.test(v) ? 'El nombre solo puede tener letras, espacios, punto, apóstrofo o guion.' : null,
            cedula: (v) => !v ? 'Escribe el documento de identidad (ejemplo: CC-88193514).'
                : !/^[A-Za-z]{0,2}-?\d{5,12}$/.test(v.replace(/[.\s]/g, '')) ? 'El documento debe tener entre 5 y 12 números, con prefijo opcional (CC-, V-, E-).' : null
        },
        enviar: (datos) => UI.postJSON('/agregar_empleado', datos),
        exito: (r) => {
            tabla.agregar(crearFila(r.empleado), true);
            UI.toast('Se registró a ' + r.empleado.nombre + ' (' + r.empleado.codigo + ').', 'success');
            document.getElementById('emp-codigo').focus();
        },
        error: (err) => { if (err.tipo === 'denegado' || err.tipo === 'red') UI.toast(err.mensaje, 'danger'); }
    });

    /* --- Eliminar: el diálogo de confirmación lo pone ui.js (data-confirm); aquí solo el envío --- */
    tablaEl.addEventListener('submit', async (e) => {
        const f = e.target.closest('.form-eliminar');
        if (!f || !f.dataset.confirmado) return;      // todavía sin confirmar: lo gestiona ui.js
        e.preventDefault();
        const btn = f.querySelector('button');
        const tr = f.closest('tr');
        UI.setLoading(btn, true);
        try {
            await UI.postJSON(f.action);
            tabla.quitar(tr);
            UI.toast('Trabajador eliminado.', 'success');
        } catch (err) {
            UI.toast(err.mensaje, 'danger');
            UI.setLoading(btn, false);
        }
    });

    /* --- Recargar la lista desde el servidor: cargando → datos | error | sin permisos --- */
    async function recargar() {
        UI.setLoading(btnActualizar, true);
        tabla.cargando(5);
        try {
            const r = await UI.getJSON('/api/empleados');
            tabla.setFilas(r.empleados.map(crearFila));
        } catch (err) {
            if (err.tipo === 'denegado') tabla.denegado();
            else tabla.error(err.mensaje, recargar);
        } finally {
            UI.setLoading(btnActualizar, false);
        }
    }
    btnActualizar.addEventListener('click', recargar);
});
</script>

<%- include('../partials/footer') %>
