<%- include('../partials/header') %>
<%
    const fmt = (n) => Number(n || 0).toLocaleString('es-CO');
    const balance = finanzas.ingresos - finanzas.nomina - finanzas.mantenimiento;
    const superavit = balance >= 0;
%>
<style>
    .dash-cab { margin-bottom: var(--space-6); }
    .dash-cab p { color: var(--text-muted); margin-top: var(--space-1); }
    .dash-graf-cab { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-4); }
    .dash-controles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); flex: 1 1 460px; max-width: 720px; }
    .dash-controles .field { margin-bottom: 0; }
    .dash-lienzo { position: relative; height: clamp(240px, 42vh, 420px); }
    .dash-datos summary { cursor: pointer; font-weight: var(--weight-semibold); margin-top: var(--space-4); color: var(--primary); }
    .dash-datos table { margin-top: var(--space-3); }
</style>

<header class="dash-cab">
    <h1>📊 Dashboard analítico y financiero</h1>
    <p>Resumen del balance acumulado y de la producción. Los valores están en pesos colombianos (COP).</p>
</header>

<!-- Nivel 1 y 2: lo primero que debe entenderse (balance) y sus componentes -->
<section aria-labelledby="h-balance">
    <h2 id="h-balance" class="sr-only">Cierre contable acumulado</h2>
    <div class="kpi-grid">
        <article class="kpi kpi-principal <%= superavit ? 'kpi-success' : 'kpi-danger' %>">
            <div class="kpi-label">Balance neto</div>
            <div class="kpi-value"><span aria-hidden="true"><%= superavit ? '▲' : '▼' %></span> <%= superavit ? '' : '−' %>$<%= fmt(Math.abs(balance)) %></div>
            <div class="kpi-note"><strong><%= superavit ? 'Superávit' : 'Déficit' %></strong> · ingresos menos nómina y mantenimiento</div>
        </article>
        <article class="kpi kpi-success">
            <div class="kpi-label">Ingresos</div>
            <div class="kpi-value">$<%= fmt(finanzas.ingresos) %></div>
            <div class="kpi-note">Ventas registradas</div>
        </article>
        <article class="kpi kpi-danger">
            <div class="kpi-label">Nómina</div>
            <div class="kpi-value">$<%= fmt(finanzas.nomina) %></div>
            <div class="kpi-note">Pagos a trabajadores</div>
        </article>
        <article class="kpi kpi-warning">
            <div class="kpi-label">Mantenimiento de máquinas</div>
            <div class="kpi-value">$<%= fmt(finanzas.mantenimiento) %></div>
            <div class="kpi-note">Costos de equipos</div>
        </article>
    </div>
</section>

<!-- Nivel 2: gráfica; los controles (nivel 4) quedan junto a su título -->
<section class="card" style="border-top: 4px solid var(--primary); margin-bottom: var(--space-6);" aria-labelledby="h-grafica">
    <div class="dash-graf-cab">
        <div>
            <h2 id="h-grafica" style="font-size: var(--text-xl);">Producción y movimientos</h2>
            <p id="dash-resumen" class="field-hint" style="margin-top: var(--space-1);"></p>
        </div>
        <div class="dash-controles">
            <div class="field">
                <label for="biDataset">Datos a mostrar</label>
                <select id="biDataset" class="input">
                    <option value="TABACOS_PRODUCCION">🚬 Tabacos fabricados (acumulado)</option>
                    <option value="MATERIA_PRIMA">🟤 Uso de materias primas</option>
                    <option value="CESTAS">🧺 Movimiento de cestas</option>
                    <option value="EGRESOS_VS_INGRESOS">💵 Ingresos frente a gastos</option>
                </select>
            </div>
            <div class="field">
                <label for="biType">Tipo de gráfica</label>
                <select id="biType" class="input">
                    <option value="bar">📊 Barras</option>
                    <option value="pie">🥧 Torta</option>
                    <option value="doughnut">🍩 Dona</option>
                    <option value="line">📈 Líneas</option>
                </select>
            </div>
        </div>
    </div>

    <div id="dash-grafica-zona">
        <div class="dash-lienzo">
            <canvas id="miGranGrafica" role="img" aria-label="Gráfica de producción y movimientos" aria-describedby="dash-resumen"></canvas>
        </div>
        <details class="dash-datos">
            <summary>Ver los datos de la gráfica en tabla</summary>
            <table id="dash-tabla">
                <caption class="sr-only">Valores representados en la gráfica</caption>
                <thead><tr><th scope="col">Categoría</th><th scope="col" class="num">Valor</th></tr></thead>
                <tbody></tbody>
            </table>
        </details>
    </div>
    <div id="dash-estado" aria-live="polite"></div>
</section>

<!-- Datos crudos como JSON (no en un atributo HTML) -->
<script type="application/json" id="raw-data"><%- JSON.stringify(raw_movs || []).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="finanzas-data"><%- JSON.stringify({ ingresos: finanzas.ingresos, nomina: finanzas.nomina, mantenimiento: finanzas.mantenimiento }) %></script>

<!-- Versión fijada de Chart.js (antes: «chart.js» sin versión) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>

<script>
    let RAW_DB = [];
    let FIN = { ingresos: 0, nomina: 0, mantenimiento: 0 };
    let datosOk = true;
    try {
        RAW_DB = JSON.parse(document.getElementById('raw-data').textContent || '[]');
        FIN = JSON.parse(document.getElementById('finanzas-data').textContent || '{}');
    } catch (e) { datosOk = false; }

    let mainChartInstance = null;
    const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    const fmt = (n) => Number(n).toLocaleString('es-CO');

    /* Cada conjunto de datos devuelve etiquetas y valores; los colores salen de los tokens (--chart-N). */
    function calcular(dataset) {
        const suma = (filtro) => RAW_DB.reduce((t, r) => t + (filtro(r) ? (Number(r.cantidad) || 0) : 0), 0);
        const mat = (r) => String(r.material || '').toLowerCase();
        if (dataset === 'TABACOS_PRODUCCION') {
            const entrada = (r) => r.tipo_movimiento === 'ENTRADA' && r.material;
            return { etiquetas: ['Tabacos normales', 'Tabacos anillados', 'Envolturas'], valores: [
                suma((r) => entrada(r) && !mat(r).includes('anillado') && !mat(r).includes('envoltura') && (mat(r).includes('normal') || mat(r) === 'tabacos' || mat(r) === 'tabaco')),
                suma((r) => entrada(r) && mat(r).includes('anillado')),
                suma((r) => entrada(r) && mat(r).includes('envoltura'))
            ], unidad: 'unidades' };
        }
        if (dataset === 'MATERIA_PRIMA') {
            const salida = (r) => r.tipo_movimiento === 'SALIDA' && r.material;
            return { etiquetas: ['Capa (kg)', 'Capote (kg)', 'Picadura (kg)'], valores: [
                suma((r) => salida(r) && mat(r).includes('capa')), suma((r) => salida(r) && mat(r).includes('capote')), suma((r) => salida(r) && mat(r).includes('picadura'))
            ], unidad: 'kilogramos' };
        }
        if (dataset === 'CESTAS') {
            return { etiquetas: ['Cestas rojas', 'Cestas azules', 'Cestas negras'], valores: [
                suma((r) => mat(r).includes('cesta') && mat(r).includes('roja')), suma((r) => mat(r).includes('cesta') && mat(r).includes('azul')), suma((r) => mat(r).includes('cesta') && mat(r).includes('negra'))
            ], unidad: 'unidades' };
        }
        return { etiquetas: ['Ingresos', 'Nómina', 'Mantenimiento'], valores: [Number(FIN.ingresos) || 0, Number(FIN.nomina) || 0, Number(FIN.mantenimiento) || 0], unidad: 'pesos (COP)' };
    }

    function renderBiChart() {
        const zona = document.getElementById('dash-grafica-zona');
        const estado = document.getElementById('dash-estado');
        estado.replaceChildren();
        if (mainChartInstance) { mainChartInstance.destroy(); mainChartInstance = null; }

        if (!datosOk) {   // estado de error: antes la gráfica quedaba vacía sin explicación
            zona.hidden = true;
            estado.appendChild(UI.estado('error', { titulo: 'No se pudieron leer los datos de la gráfica', texto: 'Recarga la página. Si el problema continúa, avisa al administrador del sistema.', acciones: [{ texto: 'Recargar', clase: 'btn-primary', onClick: () => location.reload() }] }));
            return;
        }
        const dataset = document.getElementById('biDataset').value;
        const tipo = document.getElementById('biType').value;
        const d = calcular(dataset);
        const total = d.valores.reduce((a, b) => a + b, 0);

        // Estado vacío: sin movimientos para este conjunto
        if (total === 0) {
            zona.hidden = true;
            document.getElementById('dash-resumen').textContent = '';
            estado.appendChild(UI.estado('vacio', { icono: '📊', titulo: 'Sin datos para mostrar', texto: 'Todavía no hay movimientos registrados para «' + document.getElementById('biDataset').selectedOptions[0].text.replace(/^\S+\s/, '') + '». Registra ingresos o salidas en el Kardex.', acciones: [{ texto: 'Ir al Kardex', clase: 'btn-primary', href: '/movimientos' }] }));
            return;
        }
        zona.hidden = false;

        // Texto alternativo (resumen para lectores de pantalla y para quien no distingue colores)
        const mayor = d.valores.indexOf(Math.max.apply(null, d.valores));
        document.getElementById('dash-resumen').textContent = 'Mayor valor: ' + d.etiquetas[mayor] + ' con ' + fmt(d.valores[mayor]) + ' ' + d.unidad + ' (' + Math.round(d.valores[mayor] / total * 100) + '% del total).';
        const cuerpo = document.querySelector('#dash-tabla tbody');
        cuerpo.replaceChildren(...d.etiquetas.map((e, i) => { const tr = document.createElement('tr'); const a = document.createElement('td'); a.textContent = e; const b = document.createElement('td'); b.className = 'num'; b.textContent = fmt(d.valores[i]); tr.append(a, b); return tr; }));
        document.getElementById('miGranGrafica').setAttribute('aria-label', 'Gráfica de ' + document.getElementById('biDataset').selectedOptions[0].text.replace(/^\S+\s/, '').toLowerCase() + ': ' + d.etiquetas.map((e, i) => e + ' ' + fmt(d.valores[i])).join(', '));

        const colores = [css('--chart-1'), css('--chart-2'), css('--chart-3')];
        const horizontal = tipo === 'bar';   // barras horizontales: las etiquetas largas caben también en móvil
        mainChartInstance = new Chart(document.getElementById('miGranGrafica').getContext('2d'), {
            type: tipo,
            data: { labels: d.etiquetas, datasets: [{ label: d.unidad, data: d.valores, backgroundColor: colores, borderColor: css('--bg-card'), borderWidth: 2, borderRadius: tipo === 'bar' ? 6 : 0, tension: 0.3, pointRadius: tipo === 'line' ? 5 : undefined }] },
            options: {
                responsive: true, maintainAspectRatio: false, indexAxis: horizontal ? 'y' : 'x',
                plugins: {
                    legend: { display: tipo === 'pie' || tipo === 'doughnut', labels: { color: css('--text-main'), font: { family: css('--font-main') } } },
                    tooltip: { callbacks: { label: (c) => ' ' + fmt(c.raw) + ' ' + d.unidad } }
                },
                scales: (tipo === 'pie' || tipo === 'doughnut') ? {} : {
                    x: { ticks: { color: css('--text-muted') }, grid: { color: css('--border-color') } },
                    y: { ticks: { color: css('--text-muted') }, grid: { color: css('--border-color') } }
                }
            }
        });
    }

    document.getElementById('biDataset').addEventListener('change', renderBiChart);
    document.getElementById('biType').addEventListener('change', renderBiChart);
    // Los colores de un canvas no se actualizan solos: se redibuja al cambiar el modo claro/oscuro.
    new MutationObserver(renderBiChart).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('load', renderBiChart);
</script>

<%- include('../partials/footer') %>
