<%- include('../partials/header') %>

<h1>🔄 Entradas, Salidas y Kardex</h1>
<hr>

<style>
    .kdx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-5); margin-bottom: var(--space-8); align-items: start; }
    .kdx-grid .card { padding: var(--space-5); }
    .kdx-grid h2 { font-size: var(--text-lg); margin-bottom: var(--space-4); }
    .kdx-fila { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: var(--space-3); }
    @media (max-width: 420px) { .kdx-fila { grid-template-columns: 1fr; } }
    .kdx-alerta { margin-bottom: var(--space-3); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); background: var(--danger-soft); border: 1px solid var(--danger); }
</style>

<div class="kdx-grid">

    <section class="card" style="border-top: 4px solid var(--success);" aria-labelledby="h-ingreso">
        <h2 id="h-ingreso" style="color: var(--success);">➕ Ingresar material</h2>
        <form action="/agregar_inventario" method="POST" id="form-ingreso" novalidate>
            <div class="kdx-alerta field-error" data-form-alerta role="alert" hidden></div>
            <div class="field">
                <label for="select_categoria_ingreso">Categoría</label>
                <select name="categoria" id="select_categoria_ingreso" class="input" required onchange="actualizarMateriales()">
                    <option value="">Selecciona una categoría</option>
                    <option value="Materia Prima">🟤 Materia Prima</option>
                    <option value="Cestas">🧺 Cestas</option>
                    <option value="Tabacos">🚬 Tabacos (Producción)</option>
                    <option value="Producto Terminado">📦 Producto Terminado</option>
                    <option value="Insumos">🔧 Insumos / Papelería</option>
                </select>
            </div>
            <div class="field">
                <label for="select_material_dinamico">Material</label>
                <select id="select_material_dinamico" class="input" required onchange="checkMaterialOtro(this.value)" disabled>
                    <option value="">Primero elige una categoría</option>
                </select>
                <input type="hidden" name="material" id="input_material_final">
                <label for="input_material_manual" class="sr-only">Nombre del material nuevo</label>
                <input type="text" id="input_material_manual" class="input" placeholder="Nombre del material nuevo" style="display: none; margin-top: var(--space-2);" oninput="document.getElementById('input_material_final').value = this.value;">
            </div>
            <div class="field">
                <label for="ing-cantidad">Cantidad</label>
                <input type="number" step="0.01" name="cantidad" id="ing-cantidad" class="input" placeholder="0,00" inputmode="decimal" required>
                <span class="field-hint" id="ing-cantidad-ayuda">Kilos para materia prima; unidades para cestas y tabacos.</span>
            </div>
            <div class="field">
                <label for="ing-desc">Motivo o proveedor <span style="font-weight: 400;">(opcional)</span></label>
                <input type="text" name="descripcion" id="ing-desc" class="input" placeholder="Ej: compra a proveedor">
            </div>
            <button type="submit" class="btn btn-success btn-block">Registrar ingreso</button>
        </form>
    </section>

    <script>
        const opcionesPorCategoria = {
            "Materia Prima": ["Capa", "Capote", "Picadura Bruta (Hoja)", "Tripa (Mezcla)", "Vena", "Recorte"],
            "Cestas": ["Cestas Negras", "Cestas Rojas", "Cestas Azules", "Cestas Verdes", "Cestas Amarillas", "Cestas Grises"],
            "Tabacos": ["Tabacos Generales", "Tabacos Anillados", "Tabacos Extras (Ventas)"],
            "Producto Terminado": ["Bultos Premium", "Bultos Exportación"],
            "Insumos": ["Anillos (Gato)", "Anillos (Intabaca)", "Papel de Envoltura", "Papel Timbrado", "Goma", "Periódico"]
        };

        function actualizarMateriales() {
            const cat = document.getElementById('select_categoria_ingreso').value;
            const selMat = document.getElementById('select_material_dinamico');
            const manual = document.getElementById('input_material_manual');
            const final = document.getElementById('input_material_final');

            selMat.innerHTML = ''; // Limpiar opciones
            manual.style.display = 'none';
            manual.required = false;
            final.value = '';

            if (!cat) {
                selMat.innerHTML = '<option value="">Primero elige una categoría...</option>';
                selMat.disabled = true;
                return;
            }

            selMat.disabled = false;
            selMat.innerHTML = '<option value="">-- Selecciona el Material --</option>';
            
            if (opcionesPorCategoria[cat]) {
                opcionesPorCategoria[cat].forEach(mat => {
                    selMat.innerHTML += `<option value="${mat}">${mat}</option>`;
                });
            }
            selMat.innerHTML += '<option value="OTRO">✨ OTRO / NUEVO...</option>';
        }

        function checkMaterialOtro(val) {
            const manual = document.getElementById('input_material_manual');
            const final = document.getElementById('input_material_final');
            
            if (val === 'OTRO') {
                manual.style.display = 'block';
                manual.required = true;
                final.value = manual.value;
            } else {
                manual.style.display = 'none';
                manual.required = false;
                final.value = val;
            }
        }
    </script>

    <section class="card" style="border-top: 4px solid var(--danger);" aria-labelledby="h-retiro">
        <h2 id="h-retiro" style="color: var(--danger);">➖ Retirar material</h2>
        <form action="/restar_inventario" method="POST" id="form-retiro" novalidate>
            <div class="kdx-alerta field-error" data-form-alerta role="alert" hidden></div>
            <div class="field">
                <label for="select_retiro">Material a retirar</label>
                <select name="material_id" required id="select_retiro" class="input" onchange="document.getElementById('nombre_mat').value = this.options[this.selectedIndex].text.split(' (')[0];">
                    <option value="">Selecciona qué vas a sacar</option>
                    <% if(locals.inventario) { locals.inventario.forEach(function(i) { %>
                        <option value="<%= i.id %>" data-disp="<%= i.cantidad %>"><%= i.material %> (Disp: <%= i.cantidad %>)</option>
                    <% }); } %>
                </select>
                <input type="hidden" name="nombre_material" id="nombre_mat">
            </div>
            <div class="field">
                <label for="ret-cantidad">Cantidad a retirar</label>
                <input type="number" step="0.01" name="cantidad_salida" id="ret-cantidad" class="input" placeholder="0,00" inputmode="decimal" required>
                <span class="field-hint" id="ret-cantidad-ayuda">No puede superar lo disponible.</span>
            </div>
            <div class="field">
                <label for="ret-desc">Motivo o destino <span style="font-weight: 400;">(opcional)</span></label>
                <input type="text" name="descripcion_salida" id="ret-desc" class="input" placeholder="¿Para qué o para quién?">
            </div>
            <button type="submit" class="btn btn-danger btn-block">Registrar salida</button>
        </form>
    </section>

    <section class="card" style="border-top: 4px solid var(--info);" aria-labelledby="h-venta">
        <h2 id="h-venta" style="color: var(--info);">💰 Registrar venta</h2>
        <form action="/registrar_venta" method="POST" id="form-venta" novalidate>
            <div class="kdx-alerta field-error" data-form-alerta role="alert" hidden></div>
            <div class="field">
                <label for="select_venta">Producto vendido</label>
                <select name="material_id" required id="select_venta" class="input" onchange="document.getElementById('nombre_mat_vta').value = this.options[this.selectedIndex].text.split(' (')[0];">
                    <option value="">Selecciona el producto a vender</option>
                    <% if(locals.inventario) { locals.inventario.forEach(function(i) { %>
                        <option value="<%= i.id %>" data-disp="<%= i.cantidad %>"><%= i.material %> (Disp: <%= i.cantidad %>)</option>
                    <% }); } %>
                </select>
                <input type="hidden" name="nombre_material" id="nombre_mat_vta">
            </div>
            <div class="kdx-fila">
                <div class="field">
                    <label for="vta-cantidad">Cantidad</label>
                    <input type="number" step="0.01" name="cantidad_vendida" id="vta-cantidad" class="input" placeholder="0" inputmode="decimal" required>
                </div>
                <div class="field">
                    <label for="vta-valor">Ingreso (COP)</label>
                    <input type="number" step="1" name="valor_venta" id="vta-valor" class="input" placeholder="150000" inputmode="numeric" required>
                </div>
            </div>
            <button type="submit" class="btn btn-block" style="--btn-bg: var(--info); --btn-bg-hover: #2F5470; --btn-fg: #FFFFFF;">Confirmar venta</button>
        </form>
    </section>
</div>

<script>
/* Validación con mensajes específicos; si todo es válido, el formulario se envía como siempre. */
document.addEventListener('DOMContentLoaded', function () {
    const num = (v) => parseFloat(String(v).replace(',', '.'));
    const disponible = (selId) => { const s = document.getElementById(selId); const o = s.options[s.selectedIndex]; return o && o.dataset.disp !== undefined ? num(o.dataset.disp) : null; };
    const nombreSel = (selId) => { const s = document.getElementById(selId); return s.options[s.selectedIndex] ? s.options[s.selectedIndex].text.split(' (')[0] : ''; };
    const cantidad = (selId, etiqueta) => (v) => {
        if (v === '') return 'Escribe la cantidad ' + etiqueta + '.';
        const n = num(v);
        if (!(n > 0)) return 'La cantidad debe ser mayor que cero (ejemplo: 25,5).';
        const d = disponible(selId);
        if (d !== null && n > d) return 'Solo hay ' + d + ' disponibles de ' + nombreSel(selId) + '; escribe ' + d + ' o menos.';
        return null;
    };
    UI.form(document.getElementById('form-ingreso'), { campos: {
        select_categoria_ingreso: (v) => v ? null : 'Elige la categoría del material.',
        select_material_dinamico: (v) => v ? null : 'Elige el material (o "Otro" para uno nuevo).',
        input_material_manual: (v) => document.getElementById('input_material_manual').style.display === 'none' || v ? null : 'Escribe el nombre del material nuevo.',
        cantidad: (v) => v === '' ? 'Escribe la cantidad que ingresa.' : (num(v) > 0 ? null : 'La cantidad debe ser mayor que cero (ejemplo: 25,5).')
    }});
    UI.form(document.getElementById('form-retiro'), { campos: {
        select_retiro: (v) => v ? null : 'Elige qué material vas a retirar.',
        cantidad_salida: cantidad('select_retiro', 'que retiras')
    }});
    UI.form(document.getElementById('form-venta'), { campos: {
        select_venta: (v) => v ? null : 'Elige el producto que se vendió.',
        cantidad_vendida: cantidad('select_venta', 'vendida'),
        valor_venta: (v) => v === '' ? 'Escribe cuánto dinero ingresó, en pesos (ejemplo: 150000).' : (num(v) >= 1 ? null : 'El ingreso debe ser de al menos $1.')
    }});
});
</script>

<div class="emp-cab" style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; border-bottom: 2px solid var(--border-color); padding-bottom: var(--space-3); margin: var(--space-8) 0 var(--space-4);">
    <h2 id="h-kardex" style="color: var(--text-main);">📅 Kardex interactivo (historial de movimientos)</h2>
    <button type="button" class="btn btn-ghost btn-sm" id="kdx-actualizar">↻ Actualizar</button>
</div>

<table id="tablaMovimientos" class="table-cards" aria-labelledby="h-kardex">
    <thead>
        <tr>
            <th scope="col" data-sort="texto" data-col="esencial">Fecha y hora</th>
            <th scope="col" data-sort="numero" data-col="esencial">Movimiento</th>
            <th scope="col" data-sort="texto" data-col="esencial">Material</th>
            <th scope="col" data-sort="texto" data-col="secundaria">Registrado por</th>
            <th scope="col" data-col="demanda">Detalle</th>
        </tr>
    </thead>
    <tbody>
    <% (locals.movimientos || []).forEach(function(m) {
           const mat = String(m.material || '').toLowerCase();
           let unidad = '';
           if (/capa|capote|picadura|tripa|material|vena|recorte/.test(mat)) unidad = ' Kg';
           else if (/cesta|saca|caja/.test(mat)) unidad = ' Uds';
           const entrada = m.tipo_movimiento === 'ENTRADA';
           const signed = (entrada ? 1 : -1) * (parseFloat(m.cantidad) || 0);
    %>
        <tr>
            <td data-label="Fecha y hora" data-valor="<%= m.fecha %> <%= m.hora %>">
                <strong style="font-size: var(--text-sm);"><%= m.fecha %></strong><br><span style="color: var(--text-muted); font-size: var(--text-xs);"><%= m.hora %></span>
            </td>
            <td data-label="Movimiento" data-valor="<%= signed %>">
                <span class="badge <%= entrada ? 'badge-success' : 'badge-danger' %>"><%= entrada ? '+' : '−' %> <%= m.cantidad %><%= unidad %></span>
                <span class="sr-only"><%= entrada ? 'Entrada' : 'Salida' %></span>
            </td>
            <td data-label="Material" style="text-transform: capitalize; font-weight: var(--weight-semibold);"><%= m.material %></td>
            <td data-label="Registrado por"><%= m.usuario %></td>
            <td data-label="Detalle"><%= m.descripcion || 'Sin detalle' %></td>
        </tr>
    <% }); %>
    </tbody>
</table>

<script>
/* ui.js se carga con defer: se espera a DOMContentLoaded para usar UI */
document.addEventListener('DOMContentLoaded', function () {
    const tablaEl = document.getElementById('tablaMovimientos');
    const btn = document.getElementById('kdx-actualizar');
    const tabla = UI.tabla(tablaEl, {
        tamanos: [25, 50, 100],
        etiquetaBusqueda: 'Buscar movimiento por material, usuario, fecha o detalle',
        placeholder: 'Buscar movimiento…',
        vacio: { icono: '🗂️', titulo: 'Aún no hay movimientos', texto: 'Cada ingreso, retiro o venta que registres arriba aparecerá aquí con su fecha y responsable.' }
    });

    /* Recarga: se vuelve a pedir la página y se toman sus filas (misma lógica de render que el servidor). */
    async function recargar() {
        UI.setLoading(btn, true);
        tabla.cargando(6);
        try {
            const r = await fetch('/movimientos', { credentials: 'same-origin', headers: { Accept: 'text/html' } });
            if (r.status === 401 || r.status === 403 || (r.redirected && /\/login/.test(r.url))) { tabla.denegado(); return; }
            if (!r.ok) throw { mensaje: 'El servidor respondió con un error (' + r.status + ').' };
            const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
            const filas = Array.from(doc.querySelectorAll('#tablaMovimientos tbody tr')).map((tr) => document.importNode(tr, true));
            tabla.setFilas(filas);
        } catch (err) {
            tabla.error(err && err.mensaje ? err.mensaje : 'No hay conexión con el servidor. Revisa tu internet e inténtalo de nuevo.', recargar);
        } finally {
            UI.setLoading(btn, false);
        }
    }
    btn.addEventListener('click', recargar);
});
</script>

<%- include('../partials/footer') %>